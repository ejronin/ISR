function bias(b,p){b.replaceChildren();const g=p.ground_news||{},rated=g.status==='RATED'&&g.bias_raw&&g.profile_url,na=g.status==='NOT_APPLICABLE';if(rated){A(b,'b','isr-ground-title',`GROUND NEWS · ${g.bias_raw.toUpperCase()}${g.factuality?` · ${g.factuality.toUpperCase()} FACTUALITY`:''}`);const sc=A(b,'div','isr-ground-scale');['FAR LEFT','LEFT','LEAN LEFT','CENTER','LEAN RIGHT','RIGHT','FAR RIGHT'].forEach(v=>A(sc,'span',g.bias_raw.toUpperCase()===v?'selected':'',v));const u=safe(g.profile_url);if(u){const a=A(b,'a','isr-ground-link','Ground News publisher profile ↗');a.href=u;a.target='_blank';a.rel='noopener noreferrer'}A(b,'small','','Third-party publisher context only. It does not change Atlas evidence grade.')}else{A(b,'b','isr-ground-title',na?ctx.political_bias.not_applicable_display:ctx.political_bias.unrated_display);A(b,'small','',na?'Political-bias rating is not applicable to this source type.':'No stored Ground News, AllSides or Ad Fontes rating with a verified provider profile URL is attached.')}}
function sourceUI(){const p=$('#sources');if(!p||!registry||!ctx)return;const profiles=new Map(registry.outlet_profiles.map(x=>[x.display_name,x])),by=new Map();registry.sources.forEach(s=>{if(!by.has(s.outlet_profile_id))by.set(s.outlet_profile_id,[]);by.get(s.outlet_profile_id).push(s)});$$('.isr-outlet-card',p).forEach(c=>{const pr=profiles.get($('.isr-outlet-head strong',c)?.textContent?.trim());if(!pr)return;const b=$('.isr-gn',c);if(b&&!b.dataset.r1){b.dataset.r1='1';bias(b,pr)}if($('.isr-source-context',c))return;const x=provenance(pr,by.get(pr.outlet_profile_id)||[]),n=E('div','isr-source-context'),a=A(n,'div','');A(a,'b','','Provenance: ');a.append(x.provenance.join(' · '));const r=A(n,'div','');A(r,'b','','Atlas role: ');r.append(x.atlas_role);A(n,'small','','Provenance is separate from political-bias context and evidence grade.');$('.isr-outlet-head',c)?.after(n)})}
function observers(){const sp=$('#sources');if(sp&&!sourceObs){let q=false;sourceObs=new MutationObserver(()=>{if(q)return;q=true;setTimeout(()=>{q=false;sourceUI()},40)});sourceObs.observe(sp,{childList:true,subtree:true})}if(!shellObs){let q=false;shellObs=new MutationObserver(()=>{if(q)return;q=true;setTimeout(()=>{q=false;shell();timeline();sourceUI()},50)});shellObs.observe(document.body,{childList:true,subtree:true})}}

