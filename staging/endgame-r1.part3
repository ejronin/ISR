 const s=A(p,'section','eg-source-section'),sh=A(s,'div','eg-inline-head');A(sh,'h3','','Source trail · Reuters + Iranian record');const ix=A(s,'div','eg-source-index');base.sources.filter(x=>visible(x.date)).forEach(x=>{const r=A(ix,'article','eg-source-row');A(r,'div','eg-source-meta',`${x.date} · ${x.outlet} · ${x.role}`);const u=safe(x.url);if(u){const a=A(r,'a','',x.title);a.href=u;a.target='_blank';a.rel='noopener noreferrer'}A(r,'p','',x.note)})}

function render(){if(!base||!adj)return;selected=adj.claims.some(x=>x.id===selected)?selected:adj.claims[0].id;const p=$('#endgame');p.replaceChildren();p.classList.add('eg-r1');const H=A(p,'header','eg-hero'),c=A(H,'div');A(c,'div','eg-eyebrow','Outcome audit · claim ≠ condition satisfied');A(c,'h2','','ENDGAME — claim-by-claim adjudication');A(c,'p','',adj.analytical_lock);const cut=A(H,'div','eg-cutoff');A(cut,'b','',`Evidence cutoff: ${CUTOFF()}`);A(cut,'span','','Later evidence is suppressed when the Atlas cutoff moves backward.');ribbon(p);const m=A(p,'section','eg-main'),gp=A(m,'div','eg-graph-panel'),gh=A(gp,'div','eg-inline-head');A(gh,'h3','','Structured adjudication graph');const gc=A(gh,'div','eg-graph-controls');[['FIT',fit],['−',()=>zoom(-.12)],['+',()=>zoom(.12)]].forEach(([t,f])=>{const b=A(gc,'button','eg-small-btn',t);b.type='button';b.onclick=f});const all=A(gc,'button','eg-small-btn','Show all');all.type='button';all.onclick=()=>{showAll=true;graph()};const v=A(gp,'div','eg-graph-viewport');v.id='egMermaidHost';ledger(m);graph();why(p);crosswalk(p);retained(p);tests(p);tail(p)}
function pick(id,scroll){selected=id;showAll=false;render();if(scroll)requestAnimationFrame(()=>$('#egWhyStatus')?.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'}))}

function openMou(ref){const keep=selected;window.ISRAug22Workspaces?.activatePeer?.('MOU');setTimeout(()=>{const o=$('.isr-hormuz-overlay:not([hidden])');if(!o)return;o.querySelector(`[data-mou-tab="${CSS.escape(ref.tab||'overview')}"]`)?.click();if(ref.clause){const q=String(ref.clause).toUpperCase(),card=$$('[data-mou-panel="clauses"] .isr-hormuz-card',o).find(c=>($('.eyebrow',c)?.textContent||'').toUpperCase().includes(`CLAUSE ${q}`));if(card){card.tabIndex=-1;card.classList.add('isr-mou-focus');card.scrollIntoView({block:'center'});card.focus({preventScroll:true})}}let b=$('.eg-return-endgame',o);if(!b){b=A($('.isr-hormuz-topbar',o)||o,'button','eg-return-endgame','Return to Endgame claim');b.type='button'}b.onclick=()=>{window.ISRAug22Workspaces?.activatePeer?.('ANALYSIS');window.showAtlasPanel?.('endgame');setTimeout(()=>pick(keep),0)}},80)}

function shell(){document.documentElement.classList.add('isr-compact-shell-r1');$('.kpis')?.setAttribute('aria-hidden','true');const n=$('.isr-workspace-nav');if(n&&!$('.isr-chronology-context'))n.after(E('div','isr-chronology-context','108 current chronology · 98 locked historical · reviewed through Aug 24 14:14 ET'));const g=$('.isr-authority-launch');if(g){g.dataset.globalEvidenceSearch='true';g.setAttribute('aria-label','Search all Atlas evidence')}$$('#timelineSearch').forEach(x=>x.hidden=true);$$('[data-global-evidence-search="true"]').slice(1).forEach(x=>x.hidden=true);setTimeout(()=>window.atlasMap?.invalidateSize?.(),80)}
function zoomClass(){const w=$('#timeline .isr-ruler-wrap');if(!w)return;w.classList.remove('zoom-16','zoom-32');const v=$('.isr-visual-zoom [data-visual-zoom].active')?.dataset.visualZoom;if(v?.startsWith('16'))w.classList.add('zoom-16');if(v?.startsWith('32'))w.classList.add('zoom-32')}
function timeline(){const z=$('#timeline .isr-visual-zoom');if(!z||!window.ISRAug22Workspaces?.setVisualZoom)return;['16×','32×'].forEach(v=>{if(z.querySelector(`[data-visual-zoom="${v}"]`))return;const b=A(z,'button','',v);b.type='button';b.dataset.visualZoom=v;b.onclick=()=>{window.ISRAug22Workspaces.setVisualZoom(v);zoomClass();requestAnimationFrame(()=>{$('.isr-ruler-dot.selected')?.scrollIntoView({inline:'center',block:'nearest'});if(window.AtlasState?.get?.().timeCutoff==='2026-08-24'){const d=$$('.isr-ruler-dot');d.at(-1)?.scrollIntoView({inline:'center',block:'nearest'})}})}});const h=$('#timeline .isr-timeline-help p');if(h&&!h.textContent.includes('16×'))h.textContent=h.textContent.replace('FIT / 1× / 2× / 4× / 8× changes','FIT / 1× / 2× / 4× / 8× / 16× / 32× changes');if(!z.dataset.obs){z.dataset.obs='1';new MutationObserver(zoomClass).observe(z,{attributes:true,subtree:true,attributeFilter:['class']})}zoomClass()}

function provenance(p,ss){const o=ctx.outlet_overrides[p.display_name];if(o)return o;const roles=new Set(ss.flatMap(x=>x.source_roles||[]));if(p.state_affiliation)return{provenance:['STATE MEDIA',p.country||p.state_affiliation],atlas_role:'ACTOR / STATE-AFFILIATED CLAIM PROVENANCE'};if(['WIRE_SERVICE','NEWS_AGENCY'].includes(p.outlet_type))return{provenance:['WIRE SERVICE'],atlas_role:'INDEPENDENT FACTUAL SPINE'};if(p.outlet_type==='OFFICIAL_OR_TECHNICAL')return{provenance:['MILITARY / OFFICIAL'],atlas_role:'OFFICIAL / TECHNICAL PRIMARY-SOURCE EVIDENCE'};if([...roles].some(r=>/IMAGERY|SATELLITE|GEOLOCATION/.test(r)))return{provenance:['SATELLITE / IMAGERY','OSINT / TECHNICAL'],atlas_role:'PHYSICAL-STATE EVIDENCE'};if(/CSIS|Institute|Council|Research|RAND/i.test(p.display_name))return{provenance:['THINK TANK / RESEARCH'],atlas_role:'ANALYTICAL / TECHNICAL CONTEXT'};if(p.region==='MIDDLE_EAST_NORTH_AFRICA')return{provenance:['REGIONAL NEWS'],atlas_role:'REGIONAL REPORTING / CROSS-CHECK'};if(p.outlet_type==='PUBLISHER_OR_TECHNICAL_SOURCE')return{provenance:['OSINT / TECHNICAL'],atlas_role:'TECHNICAL / SPECIALIST CONTEXT'};return{provenance:['INDEPENDENT NEWS'],atlas_role:'INDEPENDENT REPORTING'}}
