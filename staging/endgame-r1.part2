function pan(v){if(v.dataset.pan)return;v.dataset.pan='1';let on=false,sx=0,sy=0,ox=0,oy=0;v.onpointerdown=e=>{if(e.target.closest('button,a,g.node'))return;on=true;sx=e.clientX;sy=e.clientY;ox=tx.x;oy=tx.y;v.setPointerCapture?.(e.pointerId);v.classList.add('dragging')};v.onpointermove=e=>{if(!on)return;tx.x=ox+e.clientX-sx;tx.y=oy+e.clientY-sy;applyTx()};v.onpointerup=v.onpointercancel=e=>{on=false;v.classList.remove('dragging');try{v.releasePointerCapture?.(e.pointerId)}catch{}}}
function zoom(n){tx.s=Math.max(.55,Math.min(2.4,tx.s+n));applyTx()}function fit(){tx={s:1,x:0,y:0};applyTx();$('#egMermaidHost')?.scrollTo(0,0)}

function ribbon(p){const s=A(p,'section','eg-rhetorical'),h=A(s,'div','eg-inline-head');A(h,'h3','','Rhetorical contraction / walk-back');A(h,'span','','Original baseline preserved');const r=A(s,'div','eg-rhetorical-ribbon');
 (base.rhetorical_contraction||[]).filter(x=>visible(x.date)).forEach((x,i)=>{const c=A(r,'article','eg-rhetorical-step');A(c,'span','eg-rhetorical-index',i+1);A(c,'b','',x.label);A(c,'small','',x.date);A(c,'p','',x.claim)});
 const l=A(s,'div','eg-survival-lock');A(l,'b','','SURVIVAL IS AN OBSERVED FACT.');A(l,'span','','SURVIVAL WAS NOT THE ORIGINAL VICTORY CONDITION.')}
function ledger(p){const a=A(p,'aside','eg-ledger-panel'),h=A(a,'div','eg-inline-head');A(h,'h3','','Original victory-condition ledger');const all=A(h,'button','eg-small-btn','Show all paths');all.onclick=()=>{showAll=true;graph()};all.type='button';const l=A(a,'div','eg-ledger-list');
 adj.claims.forEach(c=>{const b=A(l,'button',`eg-ledger${c.id===selected?' selected':''}`);b.type='button';b.dataset.claimId=c.id;b.setAttribute('aria-pressed',c.id===selected);const t=A(b,'span','eg-ledger-top');A(t,'strong','',c.short_label);t.append(pill(c.current_disposition.state));A(b,'span','eg-ledger-reason',c.current_disposition.reasoning);b.onclick=()=>pick(c.id,true)})}
function stage(p,s,i){const c=A(p,'article','eg-trail-card');c.dataset.kind=s.kind;const m=A(c,'div','eg-meta');A(m,'span','eg-trail-index',i+1);A(m,'span','eg-phase',pretty(s.kind));A(c,'h4','',s.label);A(c,'p','',s.detail);sources(c,s.source_refs);if(s.mou_ref){const b=A(c,'button','eg-link-btn',`Open MoU ${s.mou_ref.clause?`clause ${s.mou_ref.clause}`:'workspace'} ↗`);b.type='button';b.dataset.openMou='1';b.onclick=()=>openMou(s.mou_ref)}}
function why(p){const c=claim(),s=A(p,'section','eg-why');s.id='egWhyStatus';const h=A(s,'div','eg-inline-head');A(h,'h3','','Why this status?');h.append(pill(c.current_disposition.state));const i=A(s,'div','eg-selected-intro');A(i,'strong','',c.short_label);A(i,'p','',c.current_disposition.reasoning);const tr=A(s,'div','eg-trail');c.path.forEach((x,n)=>stage(tr,x,n));
 if(c.dimensions){const b=A(s,'div','eg-hormuz-branches');A(b,'h4','','Hormuz is not one binary claim');c.dimensions.forEach(d=>{const x=A(b,'article','eg-dimension'),t=A(x,'div','eg-ledger-top');A(t,'strong','',d.label);t.append(pill(d.state));A(x,'p','',d.reasoning);sources(x,d.source_refs);const q=A(x,'button','eg-link-btn',`Open MoU clause ${d.mou_ref.clause} ↗`);q.type='button';q.onclick=()=>openMou(d.mou_ref)})}}
function crosswalk(p){const s=A(p,'section','eg-crosswalk'),h=A(s,'div','eg-inline-head');A(h,'h3','','MoU ↔ Endgame linkage');A(h,'span','eg-mou-expired',adj.mou_instrument.display_state);const n=A(s,'div','eg-mou-rule');A(n,'b','','Old instrument status: ');n.append(`${adj.mou_instrument.display_state}. ${adj.mou_instrument.new_bargain_rule}`);const g=A(s,'div','eg-crosswalk-grid');
 adj.claims.filter(c=>c.mou_relationship.relevant).forEach(c=>{const r=A(g,'article','eg-crosswalk-row');A(r,'strong','',c.short_label);A(r,'span','',c.mou_relationship.relationship);A(r,'small','',`Applicability: ${pretty(c.mou_relationship.applicability)} · Current control: ${pretty(c.mou_relationship.current_control_state)}`);if(c.mou_relationship.clause_ref){const b=A(r,'button','eg-link-btn',`Open clause ${c.mou_relationship.clause_ref}`);b.type='button';b.onclick=()=>openMou({tab:'clauses',clause:String(c.mou_relationship.clause_ref).split('/')[0]})}})}
function retained(p){const s=A(p,'section','eg-retained-evidence'),h=A(s,'div','eg-inline-head');A(h,'h3','','Pressure and counter-pressure evidence');const g=A(s,'div','eg-evidence-grid');
 const lane=(title,items,cls)=>{const l=A(g,'div',`eg-lane ${cls}`);A(l,'h4','',title);(items||[]).filter(x=>visible(x.date)).forEach(x=>{const c=A(l,'article','eg-evidence');A(c,'div','eg-meta',`${x.date} · ${x.type||''}`);A(c,'strong','',x.headline||x.label);A(c,'p','',x.detail||x.meaning||x.action||'');sources(c,(x.source_ids||[]).map(id=>({scope:'endgame',id})))})};
 lane('Evidence pressure is biting',base.strain_evidence,'positive');lane('Counter-evidence · pressure is not one-way',base.counter_evidence,'counter');const d=A(s,'details','eg-pressure-system');A(d,'summary','','Pressure system retained from current Endgame');(base.pressure_system||[]).filter(x=>visible(x.date)).forEach(x=>{const c=A(d,'article','eg-evidence');A(c,'strong','',x.label);A(c,'p','',x.action);sources(c,(x.source_ids||[]).map(id=>({scope:'endgame',id})))})}
function tests(p){const s=A(p,'section','eg-endgame-test'),h=A(s,'div','eg-inline-head');A(h,'h3','','Endgame test');const g=A(s,'div','eg-test');[['Observed reality',base.endgame_test.observed],['What does NOT logically follow',base.endgame_test.does_not_follow],['What would validate the original claim',base.endgame_test.would_validate]].forEach(([t,a])=>{const c=A(g,'article','eg-test-card');A(c,'h4','',t);const u=A(c,'ul');a.forEach(x=>A(u,'li','',x))});const w=A(s,'div','eg-warning');A(w,'strong','','Do not move the goalposts: ');w.append('the original victory standard is not retroactively reduced because later rhetoric becomes narrower.')}
function tail(p){const l=A(p,'section','eg-live-section'),h=A(l,'div','eg-inline-head');A(h,'h3','','Live endgame discriminators');const g=A(l,'div','eg-live');base.live_discriminators.forEach(x=>{const c=A(g,'article','eg-live-card');A(c,'b','',`${x.label} · ${x.status}`);A(c,'p','',x.question)});
