#endgame .eg-crosswalk-row span{display:block;font-size:8px;line-height:1.35;color:#b9c9da;margin-top:3px}
#endgame .eg-crosswalk-row small{display:block;font-size:7px;line-height:1.3;color:#869eb6;margin-top:4px}

#endgame .eg-evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}
#endgame .eg-lane{border:1px solid #29425e;border-radius:8px;padding:6px;background:#071522}
#endgame .eg-lane h4{font-size:8.5px;margin:0 0 5px}
#endgame .eg-lane.positive h4{color:#bff7d2}
#endgame .eg-lane.counter h4{color:#ffd6dd}
#endgame .eg-evidence{border-top:1px solid #203950;padding:6px 2px}
#endgame .eg-evidence:first-of-type{border-top:0}
#endgame .eg-evidence strong{font-size:8.7px}
#endgame .eg-evidence p{font-size:8px;line-height:1.35;color:#b9c9da;margin:3px 0}
#endgame .eg-pressure-system{margin-top:6px;border:1px solid #2d465e;border-radius:7px;padding:0 7px;background:#071522}
#endgame .eg-pressure-system summary{cursor:pointer;padding:7px 0;font-size:8.5px;font-weight:900;color:#dceaff}

#endgame .eg-test{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
#endgame .eg-test-card{border:1px solid #29425e;background:#0b1a2c;border-radius:8px;padding:7px}
#endgame .eg-test-card h4{font-size:8.7px;margin:0 0 5px}
#endgame .eg-test-card ul{margin:0;padding-left:15px}
#endgame .eg-test-card li{font-size:8px;line-height:1.35;color:#c3d1e1;margin:3px 0}
#endgame .eg-warning{border:1px solid #7c3f47;background:#28131a;border-radius:8px;padding:7px;margin-top:6px;font-size:8.5px;line-height:1.4;color:#f2cfd4}

#endgame .eg-live{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
#endgame .eg-live-card{border:1px dashed #405f7e;background:#0a192a;border-radius:8px;padding:7px}
#endgame .eg-live-card b{font-size:7.5px;color:var(--eg-cyan)}
#endgame .eg-live-card p{font-size:8px;line-height:1.35;color:#c3d1e1;margin:3px 0}
#endgame .eg-source-index{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}
#endgame .eg-source-row{display:block;border:1px solid #203950;background:#081522;border-radius:7px;padding:6px}
#endgame .eg-source-meta{font-size:7px;color:#8fa6c0}
#endgame .eg-source-row a{display:block;color:#b9d7ff;text-decoration:none;font-size:8px;line-height:1.3;margin-top:2px}
#endgame .eg-source-row p{font-size:7.5px;line-height:1.3;color:#9fb2c5;margin:2px 0 0}

/* ---------- Source provenance / political-bias separation ---------- */
.isr-source-context{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:4px 12px;border-top:1px solid #20384f;margin-top:6px;padding-top:6px}
.isr-source-context>div{font-size:8px;line-height:1.35;color:#c0cfde}
.isr-source-context b{color:#fff}
.isr-source-context small{grid-column:1/-1;font-size:7px;line-height:1.3;color:#7f96ad}
.isr-ground-gauge{min-width:300px;max-width:430px;display:grid!important;gap:4px!important;padding:6px!important;border:1px solid #334a61;border-radius:8px;background:#091725}
.isr-ground-title{font-size:8px!important;color:#e2ebf5}
.isr-ground-scale{display:grid;grid-template-columns:repeat(7,minmax(26px,1fr));gap:2px}
.isr-ground-scale span{display:flex;align-items:center;justify-content:center;min-height:24px;padding:2px;border:1px solid #32485e;border-radius:4px;background:#0e1d2c;color:#72879d;font-size:5.7px;font-weight:800;text-align:center;line-height:1.05}
.isr-ground-scale span.selected{border:2px solid #e8f3ff;color:#fff;background:#193b5b;box-shadow:0 0 0 1px #6fbaff inset}
.isr-ground-link{font-size:7.5px;color:#8fc7ff;text-decoration:none;width:max-content}
.isr-ground-gauge small{font-size:7px;color:#8196ab;line-height:1.25}
.isr-mou-focus{outline:2px solid #f0c878!important;outline-offset:3px}
.eg-return-endgame{margin-left:auto;white-space:nowrap}

/* narrow / mobile */
@media(max-width:1100px){
  #endgame .eg-main{grid-template-columns:minmax(0,1.55fr) minmax(280px,.85fr)}
  #endgame .eg-graph-canvas svg{min-width:980px}
  #endgame .eg-source-index{grid-template-columns:1fr}
}
@media(max-width:850px){
  .isr-compact-shell-r1 .head-row{align-items:flex-start!important}
  .isr-compact-shell-r1 .head h1{font-size:16px!important}
  .isr-compact-shell-r1 .isr-workspace-nav{position:relative!important;top:auto!important}
  .isr-compact-shell-r1 .isr-workspace-nav button{flex:0 0 94px;min-height:42px!important;height:42px!important}
  .isr-compact-shell-r1 .isr-timeline-map-slot{height:42vh!important;min-height:240px!important}
  #endgame .eg-hero{display:block}
  #endgame .eg-cutoff{border-left:0;border-top:1px solid #315170;padding:6px 0 0;margin-top:6px}
  #endgame .eg-main{grid-template-columns:1fr}
  #endgame .eg-graph-viewport{height:52vh;min-height:360px}
  #endgame .eg-ledger-list{max-height:none}
  #endgame .eg-evidence-grid,#endgame .eg-test,#endgame .eg-live{grid-template-columns:1fr}
  #endgame .eg-trail{grid-template-columns:1fr}
  #endgame .eg-crosswalk-grid{grid-template-columns:1fr}
  .isr-source-context{grid-template-columns:1fr}
  .isr-source-context small{grid-column:1}
  .isr-ground-gauge{min-width:0;width:100%;max-width:none}
}
@media(max-width:560px){
  .isr-compact-shell-r1 .head-row{display:block!important}
  .isr-compact-shell-r1 .top-actions{margin-top:5px!important}
  .isr-chronology-context{white-space:nowrap;overflow-x:auto}
  #endgame .eg-rhetorical-step{flex-basis:132px;min-width:132px}
  #endgame .eg-graph-canvas svg{min-width:860px}
}
@media(prefers-reduced-motion:reduce){
  #endgame .eg-graph-canvas,#endgame .eg-graph-canvas .node{transition:none!important}
  html{scroll-behavior:auto!important}
}
