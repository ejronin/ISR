#endgame .eg-rhetorical-step:not(:last-child)::after{content:'→';position:absolute;right:-7px;top:19px;color:var(--eg-gold);z-index:2}
#endgame .eg-rhetorical-step b{display:block;font-size:7.5px;color:#f3d18e}
#endgame .eg-rhetorical-step small{display:block;font-size:7px;color:#6fcfe3;margin:2px 0}
#endgame .eg-rhetorical-step p{font-size:8px;line-height:1.3;color:#bfcede;margin:0}
#endgame .eg-rhetorical-index{display:inline-grid;place-items:center;width:16px;height:16px;border-radius:50%;background:#3b2f18;color:#ffe1a2;font-size:7px;font-weight:900;float:right}
#endgame .eg-survival-lock{display:flex;gap:9px;align-items:center;margin-top:5px;padding-top:5px;border-top:1px solid #243b52;font-size:8.5px}
#endgame .eg-survival-lock b{color:#fff}
#endgame .eg-survival-lock span{color:#f0c878;font-weight:900}

#endgame .eg-main{display:grid;grid-template-columns:minmax(0,2.15fr) minmax(310px,.85fr);gap:8px;align-items:stretch}
#endgame .eg-graph-panel,#endgame .eg-ledger-panel{
  min-width:0;border:1px solid #2b435c;background:#081522;border-radius:10px;padding:8px
}
#endgame .eg-graph-controls{display:flex;gap:4px;align-items:center}
#endgame .eg-graph-viewport{
  position:relative;height:clamp(430px,58vh,720px);overflow:auto;border:1px solid #213b55;border-radius:8px;
  background:#06111e;cursor:grab;overscroll-behavior:contain
}
#endgame .eg-graph-viewport.dragging{cursor:grabbing;user-select:none}
#endgame .eg-graph-canvas{transform-origin:0 0;transition:transform .12s ease;width:max-content;min-width:100%;padding:10px}
#endgame .eg-graph-canvas svg{display:block;max-width:none!important;min-width:1150px;height:auto!important}
#endgame .eg-graph-canvas .node{cursor:pointer;transition:opacity .12s ease,filter .12s ease}
#endgame .eg-graph-canvas .eg-graph-dim{opacity:.17}
#endgame .eg-graph-canvas .eg-graph-active{filter:drop-shadow(0 0 5px #72b9ff88)}
#endgame .eg-graph-canvas .node:focus-visible{outline:2px solid #fff;outline-offset:3px}

#endgame .eg-ledger-list{display:grid;gap:5px;max-height:clamp(430px,58vh,720px);overflow:auto;padding-right:2px}
#endgame .eg-ledger{
  width:100%;display:block;text-align:left;border:1px solid #29425e;background:#0b1a2c;color:#eef5ff;border-radius:8px;padding:7px;cursor:pointer
}
#endgame .eg-ledger:hover{border-color:#527aa1}
#endgame .eg-ledger.selected{border-color:#72b9ff;box-shadow:inset 3px 0 0 #72b9ff;background:#102238}
#endgame .eg-ledger-top{display:flex;align-items:flex-start;justify-content:space-between;gap:6px}
#endgame .eg-ledger-top strong{font-size:9px;line-height:1.25}
#endgame .eg-ledger-reason{display:block;margin-top:4px;font-size:7.9px;line-height:1.35;color:#9fb2c7}
#endgame .eg-status{
  flex:0 0 auto;display:inline-block;border-radius:5px;padding:3px 5px;font-size:6.8px;line-height:1.15;font-weight:950;
  letter-spacing:.025em;text-align:right;border:1px solid #53677c;background:#26364c;color:#e1edf9
}
#endgame .eg-status[data-state="PROCEEDS_UNDER_IRAN_DEMAND"]{background:#103b28;border-color:#3f8d63;color:#c9f5db}
#endgame .eg-status[data-state="WALKED_BACK_DILUTED"]{background:#3a3016;border-color:#7d6730;color:#ffe1a2}
#endgame .eg-status[data-state="CUT_OFF_DENIED"]{background:#421b24;border-color:#82414d;color:#ffd6dc}
#endgame .eg-status[data-state="OPEN_UNRESOLVED"]{background:#26364c;border-color:#53677c;color:#e1edf9}

#endgame .eg-why,#endgame .eg-crosswalk,#endgame .eg-retained-evidence,#endgame .eg-endgame-test,#endgame .eg-live-section,#endgame .eg-source-section{
  border:1px solid #29425e;background:#091827;border-radius:10px;padding:9px;margin-top:8px
}
#endgame .eg-selected-status{display:flex;align-items:center}
#endgame .eg-selected-intro{border-left:3px solid #72b9ff;background:#0d2035;border-radius:6px;padding:7px 8px;margin-bottom:6px}
#endgame .eg-selected-intro strong{font-size:10px}
#endgame .eg-selected-intro p{font-size:8.8px;line-height:1.4;color:#c4d3e3;margin:3px 0 0}
#endgame .eg-trail{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:5px}
#endgame .eg-trail-card{border:1px solid #2c465f;background:#0b1a2c;border-radius:8px;padding:7px;min-width:0}
#endgame .eg-trail-card[data-kind*="MOU"]{border-color:#66507c;background:#151526}
#endgame .eg-meta{display:flex;gap:5px;align-items:center;flex-wrap:wrap;font-size:7px;color:#8fa9c1}
#endgame .eg-trail-index{display:inline-grid;place-items:center;width:16px;height:16px;border-radius:50%;background:#193b5b;color:#fff;font-weight:900}
#endgame .eg-phase{border:1px solid #3b536b;border-radius:4px;padding:2px 4px;color:#bcd2e9}
#endgame .eg-trail-card h4,#endgame .eg-dimension h4{font-size:9.3px;margin:4px 0}
#endgame .eg-trail-card p,#endgame .eg-dimension p{font-size:8.2px;line-height:1.35;color:#b9c9da;margin:3px 0}
#endgame .eg-sources{display:flex;gap:3px;flex-wrap:wrap;margin-top:5px}
#endgame .eg-source-chip{display:inline-block;border:1px solid #294a6b;background:#0d2137;color:#b9d7ff;text-decoration:none;border-radius:5px;padding:3px 5px;font-size:7px}
#endgame .eg-source-chip:hover{background:#16324f}
#endgame .eg-link-btn{margin-top:5px}
#endgame .eg-hormuz-branches{margin-top:7px;padding-top:7px;border-top:1px solid #2a4259}
#endgame .eg-hormuz-branches>h4{font-size:9px;margin:0 0 5px;color:#fff}
#endgame .eg-dimension{border:1px solid #37516a;background:#0d1d2f;border-radius:8px;padding:7px;margin:5px 0}

#endgame .eg-mou-expired{display:inline-block;border:1px solid #a45d67!important;background:#3b1920;color:#ffd3d9!important;border-radius:5px;padding:3px 6px;font-weight:950}
#endgame .eg-mou-rule{font-size:8.8px;line-height:1.4;color:#c9d6e5;border:1px solid #624b2a;background:#211a0d;border-radius:7px;padding:7px;margin-bottom:6px}
#endgame .eg-crosswalk-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:5px}
#endgame .eg-crosswalk-row{border:1px solid #304a63;background:#0b1a2c;border-radius:8px;padding:7px}
#endgame .eg-crosswalk-row strong{display:block;font-size:9px}
