/* ENDGAME / compact-shell implementation pass — 2026-08-24 R1.
   Presentation and interaction only; locked historical evidence remains unchanged. */

:root{--eg-gold:#e7b85a;--eg-red:#e46f73;--eg-green:#54c486;--eg-cyan:#63cfe6;--eg-blue:#78aee8;--eg-purple:#c29cff}

/* ---------- Global chrome recovery ---------- */
.isr-compact-shell-r1 .kpis{display:none!important}
.isr-compact-shell-r1 .head{padding:7px 10px!important;min-height:0}
.isr-compact-shell-r1 .head-row{gap:10px!important;align-items:center!important}
.isr-compact-shell-r1 .head-copy{min-width:0}
.isr-compact-shell-r1 .head h1{font-size:18px!important;line-height:1.05!important;margin:1px 0 2px!important}
.isr-compact-shell-r1 .head .kicker{font-size:7.5px!important;line-height:1.2!important}
.isr-compact-shell-r1 .head .sub{font-size:8.5px!important;line-height:1.25!important}
.isr-compact-shell-r1 .top-actions{gap:5px!important;align-items:center!important;flex-wrap:wrap!important}
.isr-compact-shell-r1 .top-actions .action-link,
.isr-compact-shell-r1 .top-actions .action-btn,
.isr-compact-shell-r1 .isr-authority-launch{min-height:29px!important;padding:4px 8px!important;font-size:8.5px!important}
.isr-compact-shell-r1 .review-stamp{font-size:8px!important;line-height:1.25!important}
.isr-compact-shell-r1 .trust-strip{min-height:22px!important;padding:3px 10px!important;gap:8px!important;font-size:7.5px!important}
.isr-compact-shell-r1 .isr-workspace-nav{
  display:flex!important;grid-template-columns:none!important;flex-wrap:nowrap!important;overflow-x:auto!important;
  gap:4px!important;padding:4px 8px!important;scrollbar-width:thin;position:sticky;top:0;z-index:24
}
.isr-compact-shell-r1 .isr-workspace-nav button{
  flex:1 1 0;min-width:88px;min-height:30px!important;height:30px!important;border-radius:6px!important;
  font-size:9.5px!important;letter-spacing:.065em!important;padding:3px 8px!important
}
.isr-compact-shell-r1 .isr-overlay-peer-nav{display:flex!important;flex-wrap:nowrap!important;overflow-x:auto!important;gap:4px!important}
.isr-compact-shell-r1 .isr-overlay-peer-nav button{min-height:30px!important;height:30px!important;padding:4px 8px!important}
.isr-chronology-context{
  display:flex;align-items:center;min-height:24px;padding:3px 10px;border-bottom:1px solid #20384f;
  background:#081522;color:#9fb5ca;font-size:8.5px;line-height:1.2;letter-spacing:.015em
}
#timelineSearch[hidden]{display:none!important}
.isr-compact-shell-r1 .analysis-nav{padding-top:3px!important;padding-bottom:3px!important}
.isr-compact-shell-r1 .primary-nav,.isr-compact-shell-r1 .secondary-nav{min-height:0!important}
.isr-compact-shell-r1 .primary-tab,.isr-compact-shell-r1 .secondary-tab{min-height:28px!important;padding:4px 7px!important;font-size:8.5px!important}

/* Timeline gets the recovered height. Visual scale remains independent of WAR/MONTH/WEEK/DAY/HOUR. */
.isr-compact-shell-r1 #app.isr-timeline-layout .content{padding:5px 9px 10px!important}
.isr-compact-shell-r1 #timeline.isr-timeline-built,
.isr-compact-shell-r1 .isr-timeline-shell{gap:5px!important}
.isr-compact-shell-r1 .isr-current-strip{padding:5px 8px!important;min-height:28px!important}
.isr-compact-shell-r1 .isr-timeline-help summary{padding:5px 0!important}
.isr-compact-shell-r1 .isr-timeline-help p{margin-bottom:6px!important}
.isr-compact-shell-r1 .isr-timeline-workbar{padding:5px 6px!important;gap:5px!important}
.isr-compact-shell-r1 .isr-timeline-map-slot{
  height:clamp(300px,calc(100vh - 315px),720px)!important;min-height:280px!important;flex:1 1 auto
}
.isr-compact-shell-r1 .isr-event-rail{min-height:108px!important}
.isr-compact-shell-r1 .isr-event-card{padding:7px!important}
.isr-visual-zoom{flex-wrap:nowrap!important;overflow-x:auto;max-width:100%}
.isr-ruler-wrap.zoom-16 .isr-ruler-label,.isr-ruler-wrap.zoom-32 .isr-ruler-label{font-size:9px!important}
.isr-ruler-wrap.zoom-32 .isr-ruler-dot{width:10px;height:10px}
.isr-ruler-wrap.zoom-32 .isr-ruler-dot.selected{width:16px;height:16px}

/* ---------- Endgame information architecture ---------- */
#endgame.eg-r1{--line:#29425e;max-width:1900px;margin:0 auto;padding-bottom:36px}
#endgame .eg-hero{
  display:flex;justify-content:space-between;gap:14px;align-items:center;border:1px solid #315170;
  background:linear-gradient(145deg,#0d2035,#0a1828);border-radius:10px;padding:9px 11px;margin-bottom:7px
}
#endgame .eg-eyebrow{font-size:7.5px;letter-spacing:.14em;font-weight:900;color:var(--eg-gold);text-transform:uppercase}
#endgame .eg-hero h2{font-size:17px;line-height:1.08;margin:3px 0 4px}
#endgame .eg-hero p{font-size:9px;line-height:1.4;color:#c7d5e5;margin:0;max-width:1100px}
#endgame .eg-cutoff{flex:0 0 auto;display:flex;flex-direction:column;gap:2px;border-left:1px solid #315170;padding-left:10px;font-size:8px;color:#a9bdd2}
#endgame .eg-cutoff b{color:#fff;font-size:8.5px}

#endgame .eg-inline-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 0 6px}
#endgame .eg-inline-head h3{font-size:10px;text-transform:uppercase;letter-spacing:.075em;margin:0;color:#d8e4f2}
#endgame .eg-inline-head>span{font-size:8px;color:#91aac4}
#endgame .eg-small-btn,#endgame .eg-link-btn,#endgame .eg-return-endgame,.eg-return-endgame{
  border:1px solid #3a5a78;background:#102840;color:#dceaff;border-radius:6px;min-height:28px;padding:4px 8px;
  font-size:8px;font-weight:850;cursor:pointer
}
#endgame button:focus-visible,.eg-return-endgame:focus-visible,.isr-source-context a:focus-visible{
  outline:2px solid #a8d4ff;outline-offset:2px
}

#endgame .eg-rhetorical{border:1px solid #2b435c;background:#091827;border-radius:9px;padding:7px 8px;margin-bottom:7px}
#endgame .eg-rhetorical-ribbon{display:flex;gap:4px;overflow-x:auto;padding-bottom:3px;scrollbar-width:thin}
#endgame .eg-rhetorical-step{
  flex:1 0 145px;min-width:145px;border:1px solid #334b64;background:#0d1c2d;border-radius:7px;padding:6px;position:relative
}
