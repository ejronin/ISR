'use strict';
(function EndgameAdjudicationR1(){
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const E=(t,c,x)=>{const n=document.createElement(t);if(c)n.className=c;if(x!=null)n.textContent=x;return n}, A=(p,t,c,x)=>{const n=E(t,c,x);p.append(n);return n};
const J=async u=>{const r=await fetch(u,{cache:'no-store'});if(!r.ok)throw Error(`${u}:${r.status}`);return r.json()};
const safe=u=>{try{const x=new URL(u,location.href);return /^https?:$/.test(x.protocol)?x.href:null}catch{return null}};
const pretty=x=>String(x??'').replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
const CUTOFF=()=>window.AtlasState?.get?.().timeCutoff||'2026-08-24';
let base,adj,hormuz,registry,ctx,selected,showAll=false,tx={s:1,x:0,y:0},sourceObs,shellObs;

function source(ref){if(!ref)return null;if(ref.scope==='endgame')return (base.sources||[]).find(x=>x.id===ref.id);if(ref.scope==='hormuz')return hormuz.sources?.[ref.id];if(ref.scope==='registry')return (registry.sources||[]).find(x=>x.source_id===ref.id);return null}
function sdate(ref,s){return ref.scope==='endgame'?s?.date:(s?.publication_date||s?.date)}
function visible(d){return !d||String(d).slice(0,10)<=CUTOFF()}
function sources(p,refs){const w=A(p,'div','eg-sources');let n=0;(refs||[]).forEach(ref=>{const s=source(ref),d=sdate(ref,s),u=safe(s?.url);if(!s||!u||!visible(d))return;const a=A(w,'a','eg-source-chip',`${s.outlet||s.label||s.title||ref.id}${d?` · ${String(d).slice(0,10)}`:''}`);a.href=u;a.target='_blank';a.rel='noopener noreferrer';n++});if(!n)w.remove()}
const state=s=>adj.terminal_state_labels[s]||s||'UNRESOLVED STATE';
function pill(s){const n=E('span','eg-status',state(s));n.dataset.state=s;return n}
function claim(){return adj.claims.find(x=>x.id===selected)||adj.claims[0]}
function mlab(v){return String(v||'').replace(/[\r\n\t]+/g,' ').replace(/["`<>#{};]/g,'').replace(/\s+/g,' ').trim().slice(0,105)}
const nid=(...x)=>x.join('_').replace(/[^A-Za-z0-9_]/g,'_');

function buildMermaidGraph(model){
 const L=['flowchart LR','classDef claim fill:#3b2f18,stroke:#e7b85a,color:#fff,stroke-width:2px;','classDef stage fill:#0d2238,stroke:#527aa1,color:#eaf2ff;','classDef mou fill:#251d35,stroke:#c29cff,color:#fff;','classDef good fill:#102b21,stroke:#68d99c,color:#fff,stroke-width:2px;','classDef bad fill:#351a21,stroke:#e46f73,color:#fff,stroke-width:2px;','classDef open fill:#243247,stroke:#90a9c4,color:#fff,stroke-width:2px;','classDef amber fill:#3d3216,stroke:#e7b85a,color:#fff,stroke-width:2px;'],M=new Map();
 const cls=s=>s==='PROCEEDS_UNDER_IRAN_DEMAND'?'good':s==='CUT_OFF_DENIED'?'bad':s==='WALKED_BACK_DILUTED'?'amber':'open';
 model.claims.forEach(c=>{L.push(`subgraph sg_${nid(c.id)}["${mlab(c.short_label)}"]`);let prev;
 (c.path||[]).forEach((st,i)=>{const id=nid(c.id,st.id);L.push(`${id}["${mlab(st.label)}"]:::${i===0?'claim':/MOU/.test(st.kind)?'mou':'stage'}`);if(prev)L.push(`${prev} --> ${id}`);prev=id;M.set(id,{claim:c.id,stage:st})});
 if(c.dimensions?.length){const sp=nid(c.id,'dimensions');L.push(`${sp}["THREE SEPARATE HORMUZ TESTS"]:::stage`,`${prev} --> ${sp}`);M.set(sp,{claim:c.id});
 c.dimensions.forEach(d=>{const id=nid(c.id,'dim',d.id);L.push(`${id}["${mlab(d.label)} — ${mlab(state(d.state))}"]:::${cls(d.state)}`,`${sp} --> ${id}`);M.set(id,{claim:c.id,dim:d})})}
 else{const id=nid(c.id,'terminal');L.push(`${id}["${mlab(state(c.current_disposition.state))}"]:::${cls(c.current_disposition.state)}`,`${prev} --> ${id}`);M.set(id,{claim:c.id})}L.push('end')});
 return {definition:L.join('\n'),nodeMeta:M}
}

function loadMermaid(){if(window.mermaid)return Promise.resolve(window.mermaid);return new Promise((ok,no)=>{let s=$('script[data-local-mermaid]');if(s){s.addEventListener('load',()=>ok(window.mermaid),{once:true});return}s=E('script');s.src='./vendor/mermaid/mermaid.min.js?v=11.6.0';s.dataset.localMermaid='11.6.0';s.onload=()=>window.mermaid?ok(window.mermaid):no(Error('Mermaid unavailable'));s.onerror=no;document.head.append(s)})}
function graphNode(svg,id){return $$('g.node',svg).find(n=>n.id===id||n.id.startsWith(`flowchart-${id}-`)||n.id.includes(`-${id}-`))}
function applyTx(){const c=$('.eg-graph-canvas');if(c)c.style.transform=`translate(${tx.x}px,${tx.y}px) scale(${tx.s})`}
async function graph(){
 const h=$('#egMermaidHost');if(!h)return;const g=buildMermaidGraph(adj);h.dataset.graphSource='structured-adjudication';
 try{const m=await loadMermaid();m.initialize({startOnLoad:false,securityLevel:'strict',theme:'dark',htmlLabels:false,flowchart:{htmlLabels:false,useMaxWidth:false}});
 const r=await m.render('isrEndgameAdjudicationGraph',g.definition);h.replaceChildren();const c=A(h,'div','eg-graph-canvas');c.innerHTML=r.svg;r.bindFunctions?.(c);const svg=$('svg',c);if(!svg)throw Error('no svg');
 svg.removeAttribute('style');svg.setAttribute('role','img');svg.setAttribute('aria-labelledby','egGraphTitle egGraphDesc');
 const ns='http://www.w3.org/2000/svg',t=document.createElementNS(ns,'title'),d=document.createElementNS(ns,'desc');t.id='egGraphTitle';t.textContent='Iranian original victory-condition adjudication';d.id='egGraphDesc';d.textContent='Claim-by-claim paths from original Iranian conditions through evidence and MoU status. Hormuz legal control, operational gatekeeping, and fee authority are separate.';svg.prepend(d);svg.prepend(t);
 g.nodeMeta.forEach((meta,id)=>{const n=graphNode(svg,id);if(!n)return;n.dataset.claimId=meta.claim;n.classList.toggle('eg-graph-dim',!showAll&&meta.claim!==selected);n.classList.toggle('eg-graph-active',!showAll&&meta.claim===selected);n.tabIndex=0;n.setAttribute('role','button');n.setAttribute('aria-label',`${adj.claims.find(x=>x.id===meta.claim)?.short_label}: ${meta.stage?.label||meta.dim?.label||'current disposition'}`);const go=e=>{if(e.type==='keydown'&&!['Enter',' '].includes(e.key))return;e.preventDefault();pick(meta.claim,true)};n.onclick=go;n.onkeydown=go});applyTx();pan(h)}
 catch(e){console.error(e);h.replaceChildren();const x=A(h,'div','callout red');A(x,'b','','Diagram unavailable.');A(x,'p','','The accessible claim ledger and evidence trail remain authoritative.')}}
