{
  "schema_version": "1.0",
  "role_definitions": {
    "CLAIM_ORIGIN": "Earliest available source showing the claim/narrative was made.",
    "OFFICIAL_STATEMENT": "Primary statement from a government, military, regulator, operator or institution; verifies the statement, not automatically the claimed effect.",
    "INDEPENDENT_CONFIRMATION": "Independent reporting/observation corroborating the underlying event or effect.",
    "REGIONAL_CORROBORATION": "Middle Eastern/regional source independently corroborating the event or position.",
    "REGIONAL_CONTRADICTION": "Regional source materially contradicting the claim/assessment.",
    "COUNTEREVIDENCE": "Evidence weighing against a claim or broader interpretation.",
    "CONTINUITY_EVIDENCE": "Affirmative evidence that capability/activity continued after damage or disruption.",
    "BDA": "Battle-damage evidence focused on physical effect.",
    "SATELLITE_IMAGERY": "Satellite/overhead imagery or imagery analysis.",
    "TECHNICAL_ANALYSIS": "Technical/quantitative analysis rather than direct primary reporting.",
    "HISTORICAL_CONTEXT": "Earlier context relevant to interpretation but not itself causal proof.",
    "PREWAR_PLANNING": "Evidence of planning/decision/posture before Feb. 28, 2026.",
    "FORCE_POSTURE": "Evidence of military deployment, withdrawal, reinforcement or rotation.",
    "CASUALTY_CONFIRMATION": "Evidence supporting casualty count/status.",
    "ECONOMIC_DATA": "Economic or market data.",
    "SHIPPING_DATA": "AIS/Kpler/Vortexa/MarineTraffic or other shipping-flow data/reporting.",
    "DIPLOMATIC_POSITION": "Negotiating position, proposal, agreement, refusal or mediation status.",
    "LATER_OUTCOME": "Evidence showing what happened after the initial event/claim.",
    "DEBUNK": "Evidence directly disproving a specific media/claim artifact.",
    "BACKGROUND_ONLY": "Background not used to prove the contested event/effect.",
    "GEOLOCATION_ONLY": "Used only to place a fixed facility/feature on the map; not used as event/BDA evidence.",
    "MUNITIONS_EXPENDITURE": "Used to support quantities/types of weapons expended.",
    "COST_MODEL": "Used to support military cost estimates or price basis."
  },
