      "public_label": "Bullshitter",
      "description": "Repeatedly publishes false/materially misleading factual claims or presents unsupported factual assertions, inferential bridges, or self-sealing evasions as established fact.",
      "window_days": 30,
      "trigger_rule": "MORE_THAN_5_QUALIFYING_INCIDENTS",
      "minimum_qualifying_incidents": 6,
      "manual_assignment_allowed": false,
      "same_information_event_deduplicated": true,
      "cross_platform_mirrors_of_same_information_event_deduplicated": true,
