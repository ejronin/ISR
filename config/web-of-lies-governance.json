        "NARRATIVE_MUTATION_OFFENDER",
        "STATE_OFFICIAL_MISINFORMATION_SOURCE"
      ],
      "correction_erases_incident": false,
      "public_wording": "Bullshitter",
      "evidence_rule": "Receipts first. False/materially misleading incidents qualify when established. Unsupported asserted facts/bridges qualify when a documented public-evidence search finds no support and records the search scope and claimant basis. Mere inability to disprove a claim is insufficient.",
      "unsupported_assertion_after_documented_search_counts": true,
      "self_sealing_evasion_counts": true,
      "mere_absence_of_disproof_is_not_support": true,
      "incomplete_or_inaccessible_evidence_counts": false,
      "unsupported_evidence_gate": {
        "required_review_status": "NO_SUPPORT_FOUND_AFTER_DOCUMENTED_SEARCH",
        "require_search_scope": true,
        "require_checked_at": true,
        "require_claimant_basis_review": true,
        "rule": "A positive factual assertion carries its own evidentiary burden. WOL may find it unsupported without proving the logical opposite, but may not convert incomplete/inaccessible evidence into an unsupported finding."
      }
    }
