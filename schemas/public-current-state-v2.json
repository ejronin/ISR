{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ejronin.github.io/ISR/schemas/public-current-state-v2.json",
  "title": "Atlas ISR Gate 3 derived public current-state read model",
  "description": "A deterministic public projection of the validated Gate 3 canonical current state. It is a read model, not a canonical evidence source.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_role",
    "authority_notice",
    "generator",
    "release",
    "counts",
    "input_packages",
    "accepted_updates",
    "accepted_updates_v2",
    "canonical_lineage",
    "input_files",
    "chronology",
    "sources",
    "entities",
    "revision_history",
    "datasets",
    "page_data",
    "consumer_coverage",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "artifact_role": { "const": "DERIVED_PUBLIC_CURRENT_STATE_READ_MODEL" },
    "generator": {
      "type": "object",
      "required": ["version", "script_path", "script_sha256", "schema_path", "schema_sha256"],
      "properties": {
        "version": { "const": "2.0" },
        "script_path": { "const": "scripts/build_public_current_state_v2_hardened.py" },
        "script_sha256": { "$ref": "#/$defs/sha256" },
        "schema_path": { "const": "schemas/public-current-state-v2.json" },
        "schema_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "repository",
        "canonical_state_identity",
        "canonical_state_identity_v2",
        "gate2_evidence_cutoff",
        "current_osint_cutoff",
        "current_osint_cutoff_display",
        "input_set_sha256",
        "release_identity"
      ],
      "properties": {
        "repository": { "const": "ejronin/ISR" },
        "canonical_state_identity": { "pattern": "^canonical-current-v1-[a-f0-9]{16}$" },
        "canonical_state_identity_v2": { "pattern": "^canonical-current-v2-[a-f0-9]{16}$" },
        "gate2_evidence_cutoff": { "const": "2026-09-05T00:37:00-04:00" },
        "current_osint_cutoff": { "const": "2026-09-05T00:37:00-04:00" },
        "current_osint_cutoff_display": { "type": "string", "minLength": 1 },
        "input_set_sha256": { "$ref": "#/$defs/sha256" },
        "release_identity": { "pattern": "^public-current-v2-[a-f0-9]{16}$" }
      }
    },
    "counts": {
      "type": "object",
      "required": ["chronology_records", "canonical_source_records", "public_actor_records", "gate3_lie_ledger_records"],
      "properties": {
        "chronology_records": { "type": "integer", "minimum": 1 },
        "canonical_source_records": { "type": "integer", "minimum": 1 },
        "public_actor_records": { "type": "integer", "minimum": 1 },
        "gate3_lie_ledger_records": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "chronology": { "type": "array", "minItems": 1 },
    "sources": {
      "type": "object",
      "required": ["records"],
      "properties": { "records": { "type": "array", "minItems": 1 } }
    },
    "datasets": { "type": "object", "minProperties": 1 },
    "page_data": {
      "type": "object",
      "required": ["start_here", "timeline", "military_record", "hormuz_economy", "diplomacy_mou", "objectives_position_changes", "claims_sources"]
    },
    "consumer_coverage": {
      "type": "object",
      "required": ["schema_version", "route_data_waivers", "dataset_waivers"]
    },
    "integrity": {
      "type": "object",
      "required": ["duplicate_event_ids", "unresolved_chronology_source_ids", "browser_replays_update_packets", "phase9_routes_consume_gate3_state"],
      "properties": {
        "duplicate_event_ids": { "const": 0 },
        "unresolved_chronology_source_ids": { "type": "array", "maxItems": 0 },
        "browser_replays_update_packets": { "const": false },
        "phase9_routes_consume_gate3_state": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
