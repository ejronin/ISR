{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ejronin.github.io/ISR/schemas/canonical-update-packet-v1.json",
  "title": "Atlas ISR canonical evidence update packet",
  "description": "Append-only, human-reviewable post-migration evidence operations. Runtime code never consumes this packet directly.",
  "type": "object",
  "required": ["schema_version", "packet_id", "status", "known_at", "summary", "operations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "packet_id": { "pattern": "^UPD-[0-9]{8}-[A-Z0-9-]+$" },
    "status": { "enum": ["DRAFT", "ACCEPTED"] },
    "known_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "revision": {
      "type": "object",
      "required": ["revision_type", "reason", "supporting_source_ids", "analytical_meaning_changed"],
      "properties": {
        "revision_type": {
          "enum": [
            "new_information",
            "attribution_clarification",
            "temporal_clarification",
            "geolocation_refinement",
            "source_correction",
            "duplicate_resolution",
            "casualty_loss_revision",
            "evidence_status_revision",
            "clerical_correction",
            "relationship_update"
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "effective_at": { "type": ["string", "null"] },
        "known_at": { "type": "string", "format": "date-time" },
        "supporting_source_ids": {
          "type": "array",
          "items": { "pattern": "^SRC-[A-F0-9]{12}$" }
        },
        "analytical_meaning_changed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["previous", "new"],
      "properties": {
        "previous": {},
        "new": {}
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["operation_id", "op", "entity_id", "revision"],
      "properties": {
        "operation_id": { "pattern": "^[A-Z0-9][A-Z0-9_-]*$" },
        "op": {
          "enum": [
            "add_event", "update_event",
            "add_source", "update_source",
            "add_actor", "update_actor",
            "add_location", "update_location",
            "add_claim", "update_claim",
            "add_material_loss", "update_material_loss",
            "link_source", "add_relationship"
          ]
        },
        "entity_id": { "type": "string", "minLength": 1 },
        "entity_type": { "enum": ["event", "source", "actor", "location", "claim", "material_loss"] },
        "record": { "type": "object" },
        "changes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/change" }
        },
        "source_id": { "pattern": "^SRC-[A-F0-9]{12}$" },
        "relationship": { "type": "object" },
        "revision": { "$ref": "#/$defs/revision" }
      },
      "additionalProperties": false
    }
  }
}
