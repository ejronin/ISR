{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ejronin.github.io/ISR/schemas/web-of-lies-source-dossier-v1.json",
  "title": "Web of Lies source dossier input",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_role",
    "authority",
    "as_of",
    "basis_paths",
    "source_profiles",
    "source_relationships",
    "external_assessments",
    "infrastructure_observations",
    "research_leads"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_role": {
      "const": "WEB_OF_LIES_SOURCE_DOSSIER_INPUT"
    },
    "authority": {
      "const": "WEB_OF_LIES_INFORMATION_FORENSICS"
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "basis_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "display_name",
          "source_entity_type",
          "behavior_classes",
          "authenticity_class",
          "revenue_model",
          "classification_basis_event_ids",
          "revenue_basis_event_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "source_entity_type": {
            "enum": [
              "OUTLET",
              "ACCOUNT",
              "INSTITUTION",
              "PERSON",
              "OTHER",
              "UNKNOWN"
            ]
          },
          "country_region": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary_platform": {
            "type": [
              "string",
              "null"
            ]
          },
          "behavior_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authenticity_class": {
            "type": "string",
            "minLength": 1
          },
          "revenue_model": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "classification_basis_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revenue_basis_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stable_identity_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "identity_confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "platform_accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "account_id",
                "platform"
              ],
              "properties": {
                "account_id": {
                  "type": "string",
                  "minLength": 1
                },
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "handle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "display_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "account_state": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "source_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "from_id",
          "to_id",
          "relationship_type",
          "evidence_source_ids"
        ],
        "properties": {
          "relationship_id": {
            "type": "string",
            "minLength": 1
          },
          "from_id": {
            "type": "string",
            "minLength": 1
          },
          "to_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship_type": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "public_receipts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/public_receipt"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "external_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assessment_id",
          "source_id",
          "assessor",
          "assessor_url",
          "publication_date",
          "rating_classification",
          "assessment_scope",
          "methodology_summary",
          "caveat",
          "retrieval_date",
          "source_url"
        ],
        "properties": {
          "assessment_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "assessor": {
            "type": "string",
            "minLength": 1
          },
          "assessor_url": {
            "type": "string",
            "minLength": 1
          },
          "publication_date": {
            "type": "string",
            "minLength": 1
          },
          "assessment_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "rating_classification": {
            "type": "string",
            "minLength": 1
          },
          "assessment_scope": {
            "type": "string",
            "minLength": 1
          },
          "methodology_summary": {
            "type": "string",
            "minLength": 1
          },
          "caveat": {
            "type": "string",
            "minLength": 1
          },
          "retrieval_date": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "infrastructure_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "source_id",
          "observation_type",
          "value",
          "observation_date",
          "source_url",
          "confidence",
          "inference_limit"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "observation_type": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "observation_date": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "minLength": 1
          },
          "inference_limit": {
            "type": "string",
            "minLength": 1
          },
          "operator_location_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "vpn_proxy_status": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "research_leads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lead_id",
          "display_name",
          "seed_urls",
          "current_disposition",
          "identity_status"
        ],
        "properties": {
          "lead_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "seed_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "current_disposition": {
            "type": "string",
            "minLength": 1
          },
          "identity_status": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "body_capture_queue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "research_item_id",
                "title",
                "url",
                "publication_date",
                "capture_status",
                "required_next_evidence",
                "research_reason"
              ],
              "properties": {
                "research_item_id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "publication_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "capture_status": {
                  "const": "TITLE_DESCRIPTION_ONLY"
                },
                "required_next_evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "research_reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "public_receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "surface",
        "provenance_status"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "archive_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_status": {
          "type": "string",
          "minLength": 1
        },
        "deletion_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
