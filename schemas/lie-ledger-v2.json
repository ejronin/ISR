{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/lie-ledger-v2.json",
  "title": "ATLAS Lie Ledger semantic record v2",
  "description": "Actor-neutral proposition, claim-instance, knowledge and evidence-link contract. Factual truth, lifecycle, knowledge, narrative function and confidence are independent dimensions.",
  "type": "object",
  "$defs": {
    "sourceRefs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^SRC-[A-F0-9]{12}$"},
      "uniqueItems": true
    },
    "relationship": {
      "type": "object",
      "required": ["type", "target_id"],
      "properties": {
        "type": {
          "enum": [
            "ASSERTS", "DENIES", "QUALIFIES", "SPECULATES_ABOUT",
            "AMPLIFIES", "REPEATS", "CORRECTS", "RETRACTS",
            "SUBSTITUTES_FOR", "SUPPORTED_BY", "CONTRADICTED_BY",
            "HAD_ACCESS_TO", "CONTROLLED", "PREVIOUSLY_ACKNOWLEDGED",
            "OMITS_MATERIAL_FACT", "PURPORTED_PROOF_OF", "USES",
            "REPEATS_TEMPLATE", "EXPLAINS", "SUPERSEDES"
          ]
        },
        "target_id": {"type": "string", "minLength": 3},
        "note": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "knowledgeIndicator": {
      "type": "object",
      "required": ["indicator", "direction", "strength", "summary", "source_refs"],
      "properties": {
        "indicator": {
          "enum": [
            "DIRECT_EVIDENCE", "DIRECT_INSTITUTIONAL_ACCESS",
            "PHYSICAL_EVIDENCE_ACCESS", "DISTINCTIVE_OBJECT_MISMATCH",
            "TEMPORAL_KNOWLEDGE", "POST_CORRECTION_REPETITION",
            "INTERNAL_CONTRADICTION", "BEHAVIORAL_CONTRADICTION",
            "NARRATIVE_SUBSTITUTION", "FABRICATED_MISLABELED_SUPPORT",
            "SELECTIVE_OMISSION", "COORDINATED_AMPLIFICATION",
            "RETROSPECTIVE_REFRAMING", "SAME_PUBLICATION_CONTRADICTION",
            "OWN_FORCE_RECORD_ACCESS", "DIPLOMATIC_RECORD_ACCESS",
            "PERSONNEL_ACCOUNTABILITY_ACCESS", "REMOTE_BDA_UNCERTAINTY"
          ]
        },
        "direction": {
          "enum": ["SUPPORTS_KNOWLEDGE", "SUPPORTS_INNOCENT_ERROR", "CONTEXT_ONLY"]
        },
        "strength": {"enum": ["CONTEXTUAL", "MODERATE", "STRONG", "DIRECT"]},
        "summary": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "available_at": {"type": ["string", "null"]},
        "temporal_role": {
          "enum": ["CONTEMPORANEOUS", "LATER_RETROSPECTIVE", "MIXED", "NOT_APPLICABLE"]
        }
      },
      "additionalProperties": false
    },
    "credibleAlternative": {
      "type": "object",
      "required": ["alternative", "comparative_weight", "basis"],
      "properties": {
        "alternative": {"type": "string", "minLength": 1},
        "comparative_weight": {
          "enum": ["MORE_PLAUSIBLE", "PLAUSIBLE", "LESS_PLAUSIBLE", "REMOTE", "UNRESOLVED"]
        },
        "basis": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "semantic_version", "doctrine_version", "proposition_id",
    "claim_instance_id", "claim", "proposition", "truth_adjudication",
    "lifecycle_status", "proposition_fidelity", "denominator_class",
    "observed_facts", "analytic_inference", "knowledge_basis",
    "knowledge_judgment", "credible_alternatives", "comparative_assessment",
    "narrative_function", "confidence", "falsifier", "evidence_refs",
    "source_ids", "relationships"
  ],
  "properties": {
    "semantic_version": {"const": "2.0"},
    "doctrine_version": {"const": "ROOK-20260909-1"},
    "record_id": {"type": "string", "minLength": 3},
    "proposition_id": {"type": "string", "minLength": 3},
    "claim_instance_id": {"type": "string", "minLength": 3},
    "original_claim_id": {"type": ["string", "null"]},
    "chain_id": {"type": ["string", "null"]},
    "narrative_family_id": {"type": ["string", "null"]},
    "actor": {"type": ["string", "null"]},
    "speaker": {"type": ["string", "null"]},
    "institution_or_publisher": {"type": ["string", "null"]},
    "claimant_type": {"type": ["string", "null"]},
    "claim": {"type": "string", "minLength": 1},
    "proposition": {"type": "string", "minLength": 1},
    "proposition_axis": {"type": ["string", "null"]},
    "proposition_fidelity": {
      "enum": [
        "SOURCE_EQUIVALENT", "ANALYTIC_DECOMPOSITION",
        "SOURCE_HEDGE_PRESERVED", "SOURCE_POLARITY_PRESERVED",
        "ANALYTIC_REFRAME_STRONGER_THAN_SOURCE", "LEGACY_SOURCE_TEXT_ONLY",
        "UNRESOLVED"
      ]
    },
    "truth_adjudication": {
      "enum": ["SUPPORTED", "PARTLY_TRUE", "MISLEADING", "FALSE", "UNRESOLVED"]
    },
    "truth_qualifier": {
      "type": ["string", "null"],
      "description": "ROOK's more specific factual/evidentiary wording, e.g. FALSE_ATTRIBUTION, UNSUBSTANTIATED, TEST_IN_MOTION, DECLARATORY_POLICY. It cannot contain a knowledge or intent finding."
    },
    "truth_basis": {"type": ["string", "null"]},
    "lifecycle_status": {
      "enum": ["ACTIVE", "CORRECTED", "RETRACTED", "ACKNOWLEDGED", "SUPERSEDED", "NOT_APPLICABLE"]
    },
    "denominator_class": {
      "enum": [
        "UNIQUE_ATOMIC_PROPOSITION", "ORIGINATING_ASSERTION",
        "REPETITION_AMPLIFICATION", "CORRECTION_RETRACTION",
        "ADMISSION_ACKNOWLEDGMENT", "MEDIA_ARTIFACT",
        "RHETORIC_DECLARATORY_POLICY", "ATLAS_CONTEXT_EFFECT_LADDER",
        "NARRATIVE_FAMILY", "CLAIM_INSTANCE", "EVIDENTIARY_INFERENCE",
        "STRATEGIC_NARRATIVE_CASE_FILE", "OFFICIAL_ASSESSMENT"
      ]
    },
    "counts_as_unique_proposition": {"type": "boolean"},
    "counts_as_claim_instance": {"type": "boolean"},
    "counts_in_falsehood_denominator": {"type": "boolean"},
    "observed_facts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "contemporaneous_baseline": {"type": ["string", "null"]},
    "current_baseline": {"type": ["string", "null"]},
    "analytic_inference": {"type": "string"},
    "knowledge_available": {"type": ["string", "null"]},
    "knowledge_basis": {
      "type": "array",
      "items": {"$ref": "#/$defs/knowledgeIndicator"}
    },
    "knowledge_judgment": {
      "enum": [
        "NOT_ASSESSED", "NOT_ASSESSABLE", "INSUFFICIENT_EVIDENCE",
        "POSSIBLE_KNOWLEDGE", "LIKELY_KNEW_FALSE",
        "VERY_LIKELY_KNEW_FALSE", "KNOWING_FALSEHOOD_ESTABLISHED"
      ]
    },
    "credible_alternatives": {
      "type": "array",
      "items": {"$ref": "#/$defs/credibleAlternative"}
    },
    "comparative_assessment": {"type": "string"},
    "combined_assessment": {"type": "string", "minLength": 1},
    "narrative_function": {"type": "string"},
    "material_omissions": {
      "type": "array", "items": {"type": "string", "minLength": 1}
    },
    "correction_repetition_history": {"type": ["string", "null"]},
    "confidence": {"enum": ["LOW", "MODERATE", "MODERATE_HIGH", "HIGH"]},
    "falsifier": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "statement_time": {"type": ["string", "null"]},
    "event_time": {"type": ["string", "null"]},
    "evidence_publication_time": {"type": ["string", "null"]},
    "knowledge_time": {"type": ["string", "null"]},
    "correction_time": {"type": ["string", "null"]},
    "assessment_time": {"type": ["string", "null"]},
    "evidence_refs": {
      "type": "object",
      "required": [
        "claim_source_refs", "factual_baseline_refs",
        "contemporaneous_evidence_refs", "knowledge_access_refs",
        "knowledge_indicator_refs", "contrary_evidence_refs",
        "correction_refs", "repetition_refs", "credible_alternative_refs",
        "comparative_inference_basis_refs", "falsifier_refs"
      ],
      "properties": {
        "claim_source_refs": {"$ref": "#/$defs/sourceRefs"},
        "factual_baseline_refs": {"$ref": "#/$defs/sourceRefs"},
        "contemporaneous_evidence_refs": {"$ref": "#/$defs/sourceRefs"},
        "knowledge_access_refs": {"$ref": "#/$defs/sourceRefs"},
        "knowledge_indicator_refs": {"$ref": "#/$defs/sourceRefs"},
        "contrary_evidence_refs": {"$ref": "#/$defs/sourceRefs"},
        "correction_refs": {"$ref": "#/$defs/sourceRefs"},
        "repetition_refs": {"$ref": "#/$defs/sourceRefs"},
        "credible_alternative_refs": {"$ref": "#/$defs/sourceRefs"},
        "comparative_inference_basis_refs": {"$ref": "#/$defs/sourceRefs"},
        "falsifier_refs": {"$ref": "#/$defs/sourceRefs"}
      },
      "additionalProperties": false
    },
    "source_ids": {"$ref": "#/$defs/sourceRefs"},
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "legacy_semantics": {
      "type": "object",
      "properties": {
        "truth_adjudication": {},
        "deception_score": {},
        "deception_basis": {},
        "knowledge_access": {}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "knowledge_judgment": {
            "enum": ["LIKELY_KNEW_FALSE", "VERY_LIKELY_KNEW_FALSE", "KNOWING_FALSEHOOD_ESTABLISHED"]
          }
        }
      },
      "then": {
        "properties": {
          "credible_alternatives": {"minItems": 1},
          "knowledge_basis": {"minItems": 1},
          "falsifier": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"knowledge_judgment": {"const": "KNOWING_FALSEHOOD_ESTABLISHED"}}
      },
      "then": {
        "properties": {
          "truth_adjudication": {"const": "FALSE"},
          "combined_assessment": {"pattern": "LIE|KNOWING FALSEHOOD"}
        }
      }
    }
  ],
  "additionalProperties": true
}
