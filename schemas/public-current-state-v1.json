{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ejronin.github.io/ISR/schemas/public-current-state-v1.json",
  "title": "Atlas ISR derived public current-state read model",
  "description": "A deterministic, non-authoritative read model assembled from the compiled canonical current entity state.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_role",
    "authority_notice",
    "generator",
    "release",
    "counts",
    "input_packages",
    "accepted_updates",
    "canonical_lineage",
    "input_files",
    "chronology",
    "sources",
    "entities",
    "revision_history",
    "datasets",
    "page_data",
    "normalizations",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_role": {
      "const": "DERIVED_PUBLIC_CURRENT_STATE_READ_MODEL"
    },
    "authority_notice": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object",
      "required": ["version", "script_path", "script_sha256", "schema_path", "schema_sha256"],
      "properties": {
        "version": { "const": "1.1" },
        "script_path": { "const": "scripts/build_public_current_state.py" },
        "script_sha256": { "$ref": "#/$defs/sha256" },
        "schema_path": { "const": "schemas/public-current-state-v1.json" },
        "schema_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "repository",
        "approved_baseline_sha",
        "canonical_migration_head",
        "canonical_state_identity",
        "current_osint_cutoff",
        "current_osint_cutoff_display",
        "input_set_sha256",
        "release_identity"
      ],
      "properties": {
        "repository": {
          "const": "ejronin/ISR"
        },
        "approved_baseline_sha": {
          "const": "9a93eea6afb1ba2f3899e96dc72e2e66071d41b1"
        },
        "canonical_migration_head": {
          "const": "b6dabf7d9dc346a81afc9ba4a9074c481e70e02a"
        },
        "canonical_state_identity": {
          "pattern": "^canonical-current-v1-[a-f0-9]{16}$"
        },
        "current_osint_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "current_osint_cutoff_display": {
          "type": "string",
          "minLength": 1
        },
        "input_set_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "release_identity": {
          "type": "string",
          "pattern": "^public-current-v1-[a-f0-9]{16}$"
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "historical_base",
        "aug_24_overlay",
        "aug_25_overlay",
        "aug_25_late_overlay",
        "aug_26_overlay",
        "historical_reconciliation",
        "aug_27_overlay",
        "chronology_records"
      ],
      "properties": {
        "historical_base": { "type": "integer", "minimum": 0 },
        "aug_24_overlay": { "type": "integer", "minimum": 0 },
        "aug_25_overlay": { "type": "integer", "minimum": 0 },
        "aug_25_late_overlay": { "type": "integer", "minimum": 0 },
        "aug_26_overlay": { "type": "integer", "minimum": 0 },
        "historical_reconciliation": { "type": "integer", "minimum": 0 },
        "aug_27_overlay": { "type": "integer", "minimum": 0 },
        "chronology_records": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "input_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inputPackage"
      }
    },
    "accepted_updates": {
      "type": "array"
    },
    "canonical_lineage": {
      "type": "object",
      "required": ["path", "sha256", "input_set_sha256", "migration_boundary"]
    },
    "input_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inputFile"
      }
    },
    "chronology": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chronologyRecord"
      }
    },
    "sources": {
      "type": "object",
      "required": ["registry_path", "registry_sha256", "outlet_profiles", "records"],
      "properties": {
        "registry_path": {
          "const": "data/source-registry.json"
        },
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "outlet_profiles": {
          "type": "array"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRecord"
          }
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "object",
      "required": ["actors", "locations", "claims", "material_losses", "relationships"]
    },
    "revision_history": {
      "type": "array"
    },
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/dataset"
      }
    },
    "page_data": {
      "type": "object",
      "required": [
        "start_here",
        "timeline",
        "military_record",
        "hormuz_economy",
        "diplomacy_mou",
        "objectives_position_changes",
        "claims_sources"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["dataset_keys"],
        "properties": {
          "dataset_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "normalizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "package_key",
          "event_id",
          "input_path",
          "event_index",
          "source_ref_index",
          "canonical_source_id",
          "meaning_changed"
        ],
        "properties": {
          "meaning_changed": {
            "const": false
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "serialization",
        "generated_timestamp_included",
        "duplicate_event_ids",
        "unresolved_chronology_source_ids",
        "unresolved_page_dataset_source_ids",
        "canonical_inputs_modified"
      ],
      "properties": {
        "generated_timestamp_included": { "const": false },
        "duplicate_event_ids": { "const": 0 },
        "unresolved_chronology_source_ids": {
          "type": "array",
          "maxItems": 0
        },
        "unresolved_page_dataset_source_ids": {
          "type": "array",
          "maxItems": 0
        },
        "canonical_inputs_modified": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputPackage": {
      "type": "object",
      "required": [
        "key",
        "path",
        "role",
        "package_name",
        "schema_version",
        "collection_cutoff",
        "contribution",
        "cumulative_chronology_records",
        "event_count",
        "timeline_count",
        "source_count",
        "manifest",
        "manifest_sha256"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputFile": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "hash_basis", "roles"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "hash_basis": { "const": "UTF8_LF_NORMALIZED" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "chronologyRecord": {
      "type": "object",
      "required": ["event_id", "event", "timeline", "source_ids", "source_references", "actor_ids", "location_ids", "claim_ids", "provenance", "revisions"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "event": { "type": "object" },
        "timeline": { "type": "object" },
        "source_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SRC-[A-F0-9]{12}$" }
        },
        "source_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "variant_key"],
            "properties": {
              "source_id": { "type": "string", "pattern": "^SRC-[A-F0-9]{12}$" },
              "variant_key": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "actor_ids": { "type": "array", "items": { "pattern": "^ACT-[A-Z0-9-]+$" } },
        "location_ids": { "type": "array", "items": { "pattern": "^LOC-[A-Z0-9-]+$" } },
        "claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        },
        "revisions": { "type": "array" }
      },
      "additionalProperties": false
    },
    "sourceRecord": {
      "type": "object",
      "required": [
        "source_id",
        "record",
        "resolution",
        "registry",
        "outlet_profile",
        "registry_status",
        "provenance",
        "variants",
        "field_conflicts",
        "revisions"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC-[A-F0-9]{12}$" },
        "record": { "type": ["object", "null"] },
        "resolution": {
          "enum": ["UNAMBIGUOUS", "PROVENANCE_SCOPED_VARIANTS_REQUIRED", "CANONICAL_UPDATE_CURRENT"]
        },
        "registry": { "type": ["object", "null"] },
        "outlet_profile": { "type": ["object", "null"] },
        "registry_status": {
          "enum": ["REGISTERED", "CANONICAL_SOURCE_NOT_YET_IN_GENERATED_REGISTRY", "CANONICAL_UPDATE_SOURCE"]
        },
        "provenance": { "type": "array", "minItems": 1 },
        "variants": { "type": "array" },
        "field_conflicts": { "type": "array" },
        "revisions": { "type": "array" }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["path", "sha256", "media_type", "role", "payload", "source_references"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "enum": ["application/json", "text/plain"] },
        "role": { "type": "string", "minLength": 1 },
        "source_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "variant_keys", "resolution"],
            "properties": {
              "source_id": { "type": "string", "pattern": "^SRC-[A-F0-9]{12}$" },
              "variant_keys": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "resolution": {
                "enum": ["UNAMBIGUOUS", "PROVENANCE_CONTEXT_REQUIRED"]
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
