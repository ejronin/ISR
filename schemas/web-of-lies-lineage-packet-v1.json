        },
        "content_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "diff_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "talk_section_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_status": {
          "type": "string",
          "minLength": 1
        },
        "deletion_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "capture_hash_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "text_excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_attribution": {
          "type": [
            "string",
            "null"
          ]
        }
