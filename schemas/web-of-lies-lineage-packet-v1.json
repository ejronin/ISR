  "$id": "https://ejronin.github.io/ISR/schemas/web-of-lies-lineage-packet-v1.json",
  "title": "Web of Lies lineage packet",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_role",
    "packet_id",
    "claim_family_id",
    "as_of",
    "basis_paths",
    "source_profiles",
    "information_events",
    "relationships",
