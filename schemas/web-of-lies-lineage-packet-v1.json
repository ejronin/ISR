          "subject_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "supersedes_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "collection_surface": {
            "type": [
              "string",
              "null"
            ]
          },
          "osint_event_kind": {
            "type": [
              "string",
              "null"
            ]
