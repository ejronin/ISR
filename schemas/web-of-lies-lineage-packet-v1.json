{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ejronin.github.io/ISR/schemas/web-of-lies-lineage-packet-v1.json",
  "title": "Web of Lies lineage packet",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_role",
    "packet_id",
    "claim_family_id",
    "as_of",
    "basis_paths",
    "source_profiles",
    "information_events",
    "relationships",
    "promotion_flags"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_role": {
      "const": "WEB_OF_LIES_LINEAGE_PACKET"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_family_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "basis_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "display_name",
          "behavior_classes",
          "authenticity_class",
          "revenue_model",
          "classification_basis_event_ids",
          "revenue_basis_event_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "source_entity_type": {
            "enum": [
              "OUTLET",
              "ACCOUNT",
              "INSTITUTION",
              "PERSON",
              "OTHER",
              "UNKNOWN"
            ]
          },
          "country_region": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary_platform": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_outlet_profile_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_actor_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "behavior_classes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "authenticity_class": {
            "type": "string",
            "minLength": 1
          },
          "revenue_model": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "classification_basis_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "revenue_basis_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "stable_identity_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "identity_confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "platform_accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "account_id",
                "platform"
              ],
              "properties": {
                "account_id": {
                  "type": "string",
                  "minLength": 1
                },
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "handle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "display_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "account_state": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "first_seen_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "last_seen_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "information_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "claim_family_id",
          "source_id",
          "event_type",
          "published_at",
          "first_observed_at",
          "epistemic_posture",
          "canonical_claim_refs",
          "evidence_source_ids"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_family_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "time_precision": {
            "type": [
              "string",
              "null"
            ]
          },
          "epistemic_posture": {
            "type": "string",
            "minLength": 1
          },
          "exact_statement": {
            "type": [
              "string",
              "null"
            ]
          },
          "translated_statement": {
            "type": [
              "string",
              "null"
            ]
          },
          "lineage_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "carrier_profile_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "canonical_claim_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "contrary_evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "correction_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "behavior_findings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "revenue_findings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "independently_sourced": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "plain_english_verdict": {
            "type": [
              "string",
              "null"
            ]
          },
          "originating_claimant": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_combined_assessment": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance_limit": {
            "type": [
              "string",
              "null"
            ]
          },
          "context_scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_receipts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/public_receipt"
            }
          },
          "independence_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "assertion_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "epistemic_posture_before": {
            "type": [
              "string",
              "null"
            ]
          },
          "epistemic_posture_after": {
            "type": [
              "string",
              "null"
            ]
          },
          "corrects_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "supersedes_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "collection_surface": {
            "type": [
              "string",
              "null"
            ]
          },
          "osint_event_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "correction_opportunity": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "monetization_context": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "content_body_evidence": {
            "type": [
              "object",
              "null"
            ],
            "$ref": "#/$defs/content_body_evidence"
          },
          "analysis_decomposition": {
            "type": [
              "object",
              "null"
            ],
            "$ref": "#/$defs/analysis_decomposition"
          }
        },
        "additionalProperties": true
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "from_id",
          "to_id",
          "relationship_type",
          "evidence_source_ids"
        ],
        "properties": {
          "relationship_id": {
            "type": "string",
            "minLength": 1
          },
          "from_id": {
            "type": "string",
            "minLength": 1
          },
          "to_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship_type": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "public_receipts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/public_receipt"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "promotion_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flag_id",
          "flag_type",
          "subject_id",
          "reason"
        ],
        "properties": {
          "flag_id": {
            "type": "string",
            "minLength": 1
          },
          "flag_type": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "generation_mode": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "public_receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "surface",
        "provenance_status"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "archive_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "diff_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "talk_section_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_status": {
          "type": "string",
          "minLength": 1
        },
        "deletion_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "capture_hash_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "text_excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_attribution": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "content_body_evidence": {
      "type": "object",
      "required": [
        "medium",
        "capture_status",
        "capture_scope",
        "transcript_receipts",
        "body_claims"
      ],
      "properties": {
        "medium": {
          "enum": [
            "TEXT_PUBLICATION",
            "SOCIAL_POST",
            "AUDIO_VIDEO",
            "WIKIPEDIA_REVISION",
            "OTHER_PUBLIC"
          ]
        },
        "capture_status": {
          "enum": [
            "FULL_TEXT_CAPTURED",
            "TRANSCRIPT_CAPTURED",
            "PARTIAL_TRANSCRIPT_CAPTURED",
            "TIMESTAMPED_DIRECT_REVIEW",
            "TITLE_DESCRIPTION_ONLY",
            "UNAVAILABLE"
          ]
        },
        "capture_scope": {
          "type": "string",
          "minLength": 1
        },
        "transcript_receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "receipt_id",
              "url",
              "provenance_status",
              "transcript_type"
            ],
            "properties": {
              "receipt_id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "provenance_status": {
                "enum": [
                  "ORIGINAL_URL",
                  "ORIGINAL_WITH_ARCHIVE",
                  "ARCHIVED_ORIGINAL",
                  "SECONDARY_PRESERVATION"
                ]
              },
              "transcript_type": {
                "enum": [
                  "PLATFORM_CAPTIONS",
                  "PUBLISHER_TRANSCRIPT",
                  "THIRD_PARTY_TRANSCRIPT",
                  "MANUAL_TIMESTAMPED_REVIEW"
                ]
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timestamp_start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timestamp_end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope_note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "body_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "body_claim_id",
              "statement_identity",
              "speaker",
              "evidence_scope"
            ],
            "properties": {
              "body_claim_id": {
                "type": "string",
                "minLength": 1
              },
              "statement_identity": {
                "type": "string",
                "minLength": 1
              },
              "speaker": {
                "type": "string",
                "minLength": 1
              },
              "timestamp_start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timestamp_end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "analysis_decomposition": {
      "type": "object",
      "required": [
        "factual_substrate",
        "inferential_bridges",
        "conclusions",
        "presentation",
        "decomposition_note"
      ],
      "properties": {
        "factual_substrate": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "evidence_status"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "PUBLICLY_SUPPORTED",
                  "PARTIALLY_SUPPORTED",
                  "CONTESTED",
                  "UNRESOLVED"
                ]
              },
              "evidence_note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_receipt_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "inferential_bridges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "statement",
              "bridge_type",
              "review_status",
              "evidentiary_issue"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "bridge_type": {
                "enum": [
                  "CAUSAL_ATTRIBUTION",
                  "MOTIVE_ATTRIBUTION",
                  "INTENT_ATTRIBUTION",
                  "CONTROL_INFERENCE",
                  "SELECTIVE_CAUSATION",
                  "GENERALIZATION",
                  "MIND_READING",
                  "FALSE_EQUIVALENCE",
                  "COUNTERFACTUAL",
                  "OTHER"
                ]
              },
              "review_status": {
                "enum": [
                  "UPSTREAM_ADJUDICATED",
                  "UPSTREAM_REVIEW_REQUIRED"
                ]
              },
              "evidentiary_issue": {
                "type": "string",
                "minLength": 1
              },
              "competing_explanations": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "conclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "conclusion_type",
              "review_status"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "conclusion_type": {
                "enum": [
                  "FACTUAL_CONCLUSION",
                  "CAUSAL_CONCLUSION",
                  "MOTIVE_CONCLUSION",
                  "CONTROL_CONCLUSION",
                  "RHETORICAL_CONCLUSION",
                  "OTHER"
                ]
              },
              "review_status": {
                "enum": [
                  "UPSTREAM_ADJUDICATED",
                  "UPSTREAM_REVIEW_REQUIRED",
                  "NON_FALSIFIABLE_OPINION",
                  "RHETORICAL_ONLY"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "decomposition_note": {
          "type": "string",
          "minLength": 1
        },
        "presentation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "surface",
              "relation_to_body",
              "review_status"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "surface": {
                "enum": [
                  "TITLE",
                  "THUMBNAIL",
                  "CAPTION",
                  "CHYRON",
                  "TEASER",
                  "DESCRIPTION",
                  "OTHER"
                ]
              },
              "relation_to_body": {
                "enum": [
                  "MATCHES_BODY",
                  "OVERSTATES_BODY",
                  "UNDERSTATES_BODY",
                  "DIFFERS_FROM_BODY",
                  "BODY_NOT_CAPTURED",
                  "UNRESOLVED"
                ]
              },
              "review_status": {
                "enum": [
                  "UPSTREAM_ADJUDICATED",
                  "UPSTREAM_REVIEW_REQUIRED",
                  "RHETORICAL_ONLY",
                  "NOT_APPLICABLE"
                ]
              },
              "evidence_note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
