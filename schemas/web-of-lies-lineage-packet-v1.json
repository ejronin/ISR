        "properties": {
          "relationship_id": {
            "type": "string",
            "minLength": 1
          },
          "from_id": {
            "type": "string",
            "minLength": 1
          },
          "to_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship_type": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "public_receipts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/public_receipt"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "promotion_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flag_id",
          "flag_type",
          "subject_id",
          "reason"
