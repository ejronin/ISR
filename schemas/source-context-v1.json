{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISR Source Context v1",
  "type": "object",
  "required": [
    "schema_version",
    "purpose",
    "political_bias",
    "provenance_categories",
    "outlet_overrides"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "purpose": {"type": "string"},
    "political_bias": {
      "type": "object",
      "required": [
        "supported_providers",
        "provider_rule",
        "unrated_display",
        "not_applicable_display"
      ]
    },
    "provenance_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "outlet_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["provenance", "atlas_role"],
        "properties": {
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "atlas_role": {"type": "string"}
        }
      }
    }
  }
}
