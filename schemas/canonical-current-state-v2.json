{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/canonical-current-state-v2.json",
  "title": "ATLAS canonical current state v2",
  "type": "object",
  "required": ["schema_version","artifact_role","release","chronology","sources","entities","daily_coverage","integrity"],
  "properties": {
    "schema_version": {"const":"2.0"},
    "artifact_role": {"const":"DERIVED_CANONICAL_CURRENT_ENTITY_STATE_V2"},
    "release": {"type":"object","required":["current_osint_cutoff","gate2_evidence_cutoff"]},
    "chronology": {"type":"array"},
    "sources": {"type":"object"},
    "entities": {"type":"object"},
    "daily_coverage": {"type":"array"},
    "integrity": {"type":"object"}
  },
  "additionalProperties": true
}
