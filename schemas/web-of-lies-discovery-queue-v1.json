{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ejronin.github.io/ISR/schemas/web-of-lies-discovery-queue-v1.json",
  "title": "Web of Lies discovery queue",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_role",
    "authority",
    "source_handoff",
    "as_of",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_role": {
      "const": "WEB_OF_LIES_DISCOVERY_QUEUE"
    },
    "authority": {
      "const": "WEB_OF_LIES_INFORMATION_FORENSICS"
    },
    "source_handoff": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "discovery_id",
          "status",
          "claim_family_ref",
          "observations",
          "downstream_note",
          "review_target",
          "review_reason"
        ],
        "properties": {
          "discovery_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "AWAITING_CANONICAL_CLAIM_FAMILY"
          },
          "claim_family_ref": {
            "type": "null"
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "downstream_note": {
            "type": "string",
            "minLength": 1
          },
          "review_target": {
            "const": "INFORMATION_CLAIMS_AND_FORENSIC_ADJUDICATION"
          },
          "review_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
