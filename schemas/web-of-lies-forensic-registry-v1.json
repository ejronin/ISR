{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ejronin.github.io/ISR/schemas/web-of-lies-forensic-registry-v1.json",
  "title": "Web of Lies derived forensic registry",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_role",
    "authority",
    "contract_path",
    "generated_from",
    "claim_families",
    "source_profiles",
    "information_events",
    "source_behavior_incidents",
    "relationships",
    "promotion_flags",
    "external_assessments",
    "infrastructure_observations",
    "research_leads",
    "hall_of_shame",
    "network_analysis",
    "incremental_rebuild_contract",
    "corpus_coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_role": {
      "const": "WEB_OF_LIES_DERIVED_FORENSIC_REGISTRY"
    },
    "authority": {
      "const": "WEB_OF_LIES_INFORMATION_FORENSICS"
    },
    "contract_path": {
      "const": "docs/WEB_OF_LIES_INFORMATION_FORENSICS_CONTRACT.md"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_from": {
      "type": "object",
      "required": [
        "canonical_state_identity",
        "lie_ledger_chain_count"
      ],
      "properties": {
        "canonical_state_identity": {
          "type": "string",
          "minLength": 1
        },
        "lie_ledger_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "forensic_input_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "claim_families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_family"
      }
    },
    "source_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_profile"
      }
    },
    "information_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information_event"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "promotion_flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/promotion_flag"
      }
    },
    "hall_of_shame": {
      "type": "object",
      "required": [
        "algorithm_version",
        "top_n_per_class",
        "manual_selection",
        "ranking_contract",
        "all_time",
        "current_period"
      ],
      "properties": {
        "algorithm_version": {
          "type": "string",
          "minLength": 1
        },
        "top_n_per_class": {
          "const": 3
        },
        "manual_selection": {
          "const": false
        },
        "current_period_days": {
          "type": "integer",
          "minimum": 1
        },
        "ranking_contract": {
          "type": "object",
          "required": [
            "score_weights",
            "event_metric_map",
            "qualification_metric_keys",
            "lower_threshold_classes",
            "hall_of_shame_classes",
            "default_min_families",
            "default_min_events",
            "lower_min_families",
            "lower_min_events",
            "downstream_log2_cap"
          ],
          "properties": {
            "score_weights": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "event_metric_map": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "qualification_metric_keys": {
              "$ref": "#/$defs/string_array"
            },
            "lower_threshold_classes": {
              "$ref": "#/$defs/string_array"
            },
            "hall_of_shame_classes": {
              "$ref": "#/$defs/string_array"
            },
            "default_min_families": {
              "type": "integer",
              "minimum": 0
            },
            "default_min_events": {
              "type": "integer",
              "minimum": 0
            },
            "lower_min_families": {
              "type": "integer",
              "minimum": 0
            },
            "lower_min_events": {
              "type": "integer",
              "minimum": 0
            },
            "downstream_log2_cap": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "all_time": {
          "$ref": "#/$defs/ranking_view"
        },
        "current_period": {
          "$ref": "#/$defs/ranking_view"
        }
      },
      "additionalProperties": true
    },
    "network_analysis": {
      "type": "object",
      "required": [
        "family_analysis",
        "summary"
      ],
      "properties": {
        "family_analysis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim_family_id",
              "documented_propagation_edges",
              "independent_corroboration_events",
              "derivative_repetition_events",
              "unknown_independence_events",
              "citation_laundering_findings",
              "circular_source_components",
              "material_mutation_events",
              "public_receipt_count"
            ],
            "additionalProperties": true
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "documented_propagation_edges",
            "citation_laundering_findings",
            "circular_source_findings",
            "material_mutation_findings",
            "social_platforms_represented",
            "deletion_status_counts",
            "correction_state_counts"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "incremental_rebuild_contract": {
      "type": "object",
      "required": [
        "affected_family_isolation",
        "unaffected_family_state_preserved",
        "source_profiles_and_hall_recomputed_when_affected",
        "clean_full_build_equivalence_required",
        "stale_previous_registry_fails_closed"
      ],
      "additionalProperties": false,
      "properties": {
        "affected_family_isolation": {
          "const": true
        },
        "unaffected_family_state_preserved": {
          "const": true
        },
        "source_profiles_and_hall_recomputed_when_affected": {
          "const": true
        },
        "clean_full_build_equivalence_required": {
          "const": true
        },
        "stale_previous_registry_fails_closed": {
          "const": true
        }
      }
    },
    "corpus_coverage": {
      "type": "object",
      "required": [
        "family_coverage",
        "summary",
        "completion_claim",
        "interpretation"
      ],
      "properties": {
        "family_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim_family_id",
              "coverage_status",
              "canonical_anchor_events",
              "non_anchor_lineage_events",
              "documented_relationships",
              "origin_events",
              "carrier_or_amplifier_events",
              "correction_or_retraction_events",
              "adverse_behavior_events",
              "public_osint_events",
              "public_receipt_count",
              "research_gaps"
            ],
            "properties": {
              "claim_family_id": {
                "type": "string",
                "minLength": 1
              },
              "coverage_status": {
                "enum": [
                  "CANONICAL_FAMILY_NO_LINEAGE",
                  "ANCHOR_ONLY",
                  "LINEAGE_SEEDED",
                  "LINEAGE_TRACED"
                ]
              },
              "canonical_anchor_events": {
                "type": "integer",
                "minimum": 0
              },
              "non_anchor_lineage_events": {
                "type": "integer",
                "minimum": 0
              },
              "documented_relationships": {
                "type": "integer",
                "minimum": 0
              },
              "origin_events": {
                "type": "integer",
                "minimum": 0
              },
              "carrier_or_amplifier_events": {
                "type": "integer",
                "minimum": 0
              },
              "correction_or_retraction_events": {
                "type": "integer",
                "minimum": 0
              },
              "adverse_behavior_events": {
                "type": "integer",
                "minimum": 0
              },
              "public_osint_events": {
                "type": "integer",
                "minimum": 0
              },
              "public_receipt_count": {
                "type": "integer",
                "minimum": 0
              },
              "research_gaps": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "canonical_claim_families",
            "status_counts",
            "families_with_non_anchor_lineage",
            "families_without_non_anchor_lineage",
            "families_with_public_osint_receipts",
            "families_without_public_osint_receipts"
          ],
          "properties": {
            "canonical_claim_families": {
              "type": "integer",
              "minimum": 0
            },
            "status_counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "families_with_non_anchor_lineage": {
              "type": "integer",
              "minimum": 0
            },
            "families_without_non_anchor_lineage": {
              "type": "integer",
              "minimum": 0
            },
            "families_with_public_osint_receipts": {
              "type": "integer",
              "minimum": 0
            },
            "families_without_public_osint_receipts": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "completion_claim": {
          "const": "NONE"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "external_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external_assessment"
      }
    },
    "infrastructure_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/infrastructure_observation"
      }
    },
    "research_leads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/research_lead"
      }
    },
    "source_behavior_incidents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_behavior_incident"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claim_family": {
      "type": "object",
      "required": [
        "claim_family_id",
        "canonical_chain_id",
        "title",
        "source_ids",
        "trace_status"
      ],
      "properties": {
        "claim_family_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_chain_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "canonical_adjudication": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "$ref": "#/$defs/string_array"
        },
        "trace_status": {
          "enum": [
            "UNTRACED",
            "PARTIAL",
            "TRACED"
          ]
        },
        "information_event_ids": {
          "$ref": "#/$defs/string_array"
        },
        "relationship_ids": {
          "$ref": "#/$defs/string_array"
        }
      },
      "additionalProperties": true
    },
    "source_profile": {
      "type": "object",
      "required": [
        "source_id",
        "display_name",
        "behavior_classes",
        "authenticity_class",
        "revenue_model",
        "classification_basis_event_ids",
        "revenue_basis_event_ids",
        "metrics"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "country_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_entity_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_outlet_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_source_ids": {
          "$ref": "#/$defs/string_array"
        },
        "behavior_classes": {
          "$ref": "#/$defs/string_array"
        },
        "authenticity_class": {
          "type": "string",
          "minLength": 1
        },
        "revenue_model": {
          "$ref": "#/$defs/string_array"
        },
        "classification_basis_event_ids": {
          "$ref": "#/$defs/string_array"
        },
        "revenue_basis_event_ids": {
          "$ref": "#/$defs/string_array"
        },
        "metrics": {
          "type": "object",
          "required": [
            "claim_families_traced",
            "false_misleading_findings_connected",
            "narrative_mutations_introduced",
            "citation_laundering_events",
            "recycled_media_incidents",
            "corrections_issued",
            "continued_after_correction_incidents",
            "failed_claims_deleted_or_abandoned",
            "stealth_edits",
            "victim_exploitation_incidents",
            "unique_propagation_events",
            "prediction_failures",
            "prediction_corrections"
          ],
          "properties": {
            "claim_families_traced": {
              "type": "integer",
              "minimum": 0
            },
            "false_misleading_findings_connected": {
              "type": "integer",
              "minimum": 0
            },
            "narrative_mutations_introduced": {
              "type": "integer",
              "minimum": 0
            },
            "citation_laundering_events": {
              "type": "integer",
              "minimum": 0
            },
            "recycled_media_incidents": {
              "type": "integer",
              "minimum": 0
            },
            "corrections_issued": {
              "type": "integer",
              "minimum": 0
            },
            "continued_after_correction_incidents": {
              "type": "integer",
              "minimum": 0
            },
            "failed_claims_deleted_or_abandoned": {
              "type": "integer",
              "minimum": 0
            },
            "stealth_edits": {
              "type": "integer",
              "minimum": 0
            },
            "victim_exploitation_incidents": {
              "type": "integer",
              "minimum": 0
            },
            "unique_propagation_events": {
              "type": "integer",
              "minimum": 0
            },
            "observed_downstream_propagation": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "prediction_failures": {
              "type": "integer",
              "minimum": 0
            },
            "prediction_corrections": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "direct_verdict": {
          "type": [
            "string",
            "null"
          ]
        },
        "stable_identity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_confidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform_accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "source_awards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "award_code",
              "public_label",
              "window_days",
              "minimum_qualifying_incidents",
              "award_earned_at",
              "qualifying_window_start",
              "qualifying_window_end",
              "qualifying_incident_count",
              "qualifying_incident_ids",
              "current_window_status",
              "currently_active",
              "current_window_incident_count",
              "current_window_incident_ids",
              "as_of",
              "public_verdict"
            ],
            "properties": {
              "award_code": {
                "const": "BULLSHITTER"
              },
              "public_label": {
                "type": "string",
                "minLength": 1
              },
              "window_days": {
                "type": "integer",
                "minimum": 1
              },
              "minimum_qualifying_incidents": {
                "type": "integer",
                "minimum": 1
              },
              "qualifying_incident_count": {
                "type": "integer",
                "minimum": 1
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "public_verdict": {
                "type": "string",
                "minLength": 1
              },
              "qualifying_incident_ids": {
                "$ref": "#/$defs/string_array"
              },
              "award_earned_at": {
                "type": "string",
                "minLength": 1
              },
              "qualifying_window_start": {
                "type": "string",
                "minLength": 1
              },
              "qualifying_window_end": {
                "type": "string",
                "minLength": 1
              },
              "current_window_status": {
                "enum": [
                  "ACTIVE_CURRENT_WINDOW",
                  "EARNED_HISTORICAL"
                ]
              },
              "currently_active": {
                "type": "boolean"
              },
              "current_window_incident_count": {
                "type": "integer",
                "minimum": 0
              },
              "current_window_incident_ids": {
                "$ref": "#/$defs/string_array"
              }
            },
            "additionalProperties": false
          }
        },
        "classification_basis_incident_ids": {
          "$ref": "#/$defs/string_array"
        }
      },
      "additionalProperties": true
    },
    "information_event": {
      "type": "object",
      "required": [
        "event_id",
        "claim_family_id",
        "source_id",
        "event_type",
        "published_at",
        "first_observed_at",
        "epistemic_posture",
        "canonical_claim_refs",
        "evidence_source_ids"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_family_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_observed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "epistemic_posture": {
          "type": "string",
          "minLength": 1
        },
        "exact_statement": {
          "type": [
            "string",
            "null"
          ]
        },
        "translated_statement": {
          "type": [
            "string",
            "null"
          ]
        },
        "lineage_roles": {
          "$ref": "#/$defs/string_array"
        },
        "carrier_profile_ids": {
          "$ref": "#/$defs/string_array"
        },
        "canonical_claim_refs": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_source_ids": {
          "$ref": "#/$defs/string_array"
        },
        "contrary_evidence_source_ids": {
          "$ref": "#/$defs/string_array"
        },
        "correction_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "behavior_findings": {
          "$ref": "#/$defs/string_array"
        },
        "revenue_findings": {
          "$ref": "#/$defs/string_array"
        },
        "independently_sourced": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "downstream_propagation_observed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "plain_english_verdict": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/public_receipt"
          }
        },
        "independence_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "assertion_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "epistemic_posture_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "epistemic_posture_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "corrects_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes_event_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": [
        "relationship_id",
        "from_id",
        "to_id",
        "relationship_type",
        "evidence_source_ids"
      ],
      "properties": {
        "relationship_id": {
          "type": "string",
          "minLength": 1
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "relationship_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence_source_ids": {
          "$ref": "#/$defs/string_array"
        },
        "public_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/public_receipt"
          }
        }
      },
      "additionalProperties": true
    },
    "promotion_flag": {
      "type": "object",
      "required": [
        "flag_id",
        "flag_type",
        "subject_id",
        "reason"
      ],
      "properties": {
        "flag_id": {
          "type": "string",
          "minLength": 1
        },
        "flag_type": {
          "enum": [
            "FORENSIC_DISCOVERY",
            "EVIDENCE_PROMOTION_CANDIDATE",
            "ADJUDICATION_REVIEW_CANDIDATE"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_source_ids": {
          "$ref": "#/$defs/string_array"
        }
      },
      "additionalProperties": true
    },
    "ranking_entry": {
      "type": "object",
      "required": [
        "rank",
        "source_id",
        "source_class",
        "score",
        "ranking_basis",
        "why_this_source_appears_here"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
